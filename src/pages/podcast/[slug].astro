---
// The podcast detail template, nativised (REBUILD-PLAN.md Phase 4, collection
// `podcast`, shape 73de8beb, 5 pages). DetailPage/render-detail.mjs and this
// collection's shell+bindings stay in the tree -- other collections still use that
// path -- but /podcast/<slug> no longer does.
//
// htmlAttrs/nav variant/footer variant are the same per-collection constants
// src/shells/_detail/manifest.json["podcast"] already recorded (proven static across
// all 5 items), hardcoded here rather than parsed at build time since this route no
// longer reads that manifest for anything else. This collection's shell DOES carry
// the banner-wrap block before the nav (same as blog/careers) and a footer after the
// content -- see src/shells/_detail/podcast/body.html.
//
// src/lib/podcast-detail.ts's own header comment documents three things
// src/bindings/podcast.json gets wrong or misses entirely (the <title> pattern's
// double space, description/og/twitter coming from `excerpt`, and the alt text
// coming from `guest-name`) -- worked out from src/shells/_detail/podcast/head.html
// and reference/live/podcast/*.html directly rather than trusted from the binding.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import {
  fmtDate, richText, guestImageUrl, guestName, headTitle, headDescription, headImage,
  embedId, embedSrc,
} from '../../lib/podcast-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import PodcastSection from '../../components/podcast/PodcastSection.astro';

export const getStaticPaths = () => getPaths('podcast');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/podcast/${slug}`;

const title = headTitle(item);
const description = headDescription(item);
const image = headImage(item);

// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive. podcast-head.html is its own asset (not
// the shared detail-head.html) because this collection's live pages carry one extra
// tag the generic tail doesn't: <link rel="alternate" ... rss.xml> (see
// src/lib/podcast-detail.ts's header comment).
const headTail = readFileSync('src/components/podcast/podcast-head.html', 'utf8')
  .replace('__CANON__', `https://www.radixdlt.com${currentPath}`);
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d966" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title={title}
      description={description}
      ogTitle={title}
      ogDescription={description}
      ogImage={image}
      twitterTitle={title}
      twitterDescription={description}
      twitterImage={image}
      ogType
      twitterCard
      tail={headTail}
    />
  </head>
  <body>
    <div class="banner-wrap">
      <div data-w-id="421cf4db-2453-441c-6135-5b6acee23bfc" class="x-holder x2"><img src="/images/close-1.svg" loading="lazy" alt="" class="imgclose" /></div>
    </div>
    <SiteNav variant="main" currentPath={currentPath} />
    <PodcastSection
      title={item.fieldData.name as string}
      dateText={fmtDate(item.fieldData.date)}
      embedId={embedId(slug)}
      embedSrc={embedSrc(item, slug)}
      guestImageUrl={guestImageUrl(item)}
      guestAlt={guestName(item)}
      contentHtml={richText(item)}
    />
    <SiteFooter variant="main" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
