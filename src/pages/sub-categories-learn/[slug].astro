---
// The sub-categories-learn detail template, nativised (REBUILD-PLAN.md Phase 4,
// taxonomy shape 684e5a6b, 1 page): real Astro markup fed by content collections,
// replacing the DetailPage.astro shell-splicing path for this one route.
// DetailPage/render-detail.mjs/this collection's shell+bindings stay in the tree --
// other collections still use that path -- but /sub-categories-learn/<slug> no longer
// does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["sub-categories-learn"] already recorded,
// hardcoded here for the same reason careers'/categories-learn's own pages do.
// bodyAttrs is empty; no banner-wrap or search-mobile block.
//
// Shared with categories-learn (see src/lib/categories-learn-detail.ts for why): the
// hero and question-list blocks. Only one live item (olympia-general-information),
// whose own "Featured Questions" list is empty -- getQuestions/getStaticPaths still
// route it through the real CMS data path rather than hand-coding the empty result,
// so a future published sub-category with actual featured questions renders correctly
// without further changes.
//
// getSubCategoryHero resolves this page's title+icon from the PARENT categories-learn
// item (via the `main-category` reference), not from this item's own fields -- see
// that function's doc comment in src/lib/categories-learn-detail.ts for how this was
// confirmed against reference/live rather than assumed.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/render-detail.mjs';
import { getQuestions, getSubCategoryHero } from '../../lib/categories-learn-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import CategoryHero from '../../components/learn-taxonomy/CategoryHero.astro';
import QuestionList from '../../components/learn-taxonomy/QuestionList.astro';

export const getStaticPaths = () => getPaths('sub-categories-learn');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/sub-categories-learn/${slug}`;

const [hero, featured] = await Promise.all([
  getSubCategoryHero(item),
  getQuestions('sub-categories-learn', slug, '0'),
]);

const title = resolveHeadTitle('sub-categories-learn', item) ?? 'Radix';
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive.
const headTail = readFileSync('src/components/detail-shared/detail-head.html', 'utf8')
  .replace('__CANON__', 'https://www.radixdlt.com/detail_sub-categories-learn');
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="69eb1ebc49e0fc5f9abc3044" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head><SiteHead title={title} tail={headTail} /></head>
  <body>
    <SiteNav variant="learn" currentPath={currentPath} />
    <CategoryHero iconUrl={hero.parentIconUrl} title={hero.parentName} subtitle={hero.ownName} />
    <QuestionList title="Featured Questions" items={featured} emptyStateClass="w-dyn-empty" />
    <SiteFooter variant="learn" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
