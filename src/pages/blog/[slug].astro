---
// The blog detail template, nativised (REBUILD-PLAN.md Phase 4 step 3): real Astro
// markup fed by content collections, replacing the DetailPage.astro shell-splicing
// path for this one route. DetailPage/render-detail.mjs/the blog shell+bindings stay
// in the tree -- other collections still use that path -- but /blog/<slug> no longer
// does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["blog"] already recorded (proven static
// across all 618 items, not per-item data), hardcoded here rather than parsed at
// build time since this route no longer reads that manifest for anything else.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/render-detail.mjs';
import {
  getAuthor, getCategories, getExploreTopics, getRelatedArticles, getSliderPosts,
  fmtDate, heroImage, headDescription, headImage, richText,
} from '../../lib/blog-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import BlogContent from '../../components/blog/BlogContent.astro';
import BlogTags from '../../components/blog/BlogTags.astro';

export const getStaticPaths = () => getPaths('blog');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/blog/${slug}`;

const [categories, author, related, topics, slider] = await Promise.all([
  getCategories(item),
  getAuthor(item),
  getRelatedArticles(slug),
  getExploreTopics(slug),
  getSliderPosts(slug),
]);

const title = resolveHeadTitle('blog', item) ?? '| The Radix Blog | Radix DLT';
const description = headDescription(item);
const image = headImage(item);
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive.
const headTail = readFileSync('src/components/blog/blog-head.html', 'utf8');
const scriptsTail = readFileSync('src/components/blog/blog-scripts.html', 'utf8');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d94b" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title={title}
      description={description}
      ogTitle={title}
      ogDescription={description}
      ogImage={image}
      twitterTitle={title}
      twitterDescription={description}
      twitterImage={image}
      ogType
      twitterCard
      canonical={`https://www.radixdlt.com${currentPath}`}
      tail={headTail}
    />
  </head>
  <body>
    <div class="banner-wrap">
      <div data-w-id="421cf4db-2453-441c-6135-5b6acee23bfc" class="x-holder x2"><img src="/images/close-1.svg" loading="lazy" alt="" class="imgclose" /></div>
    </div>
    <SiteNav variant="blog" currentPath={currentPath} />
    <div class="search-mobile">
      <div class="container">
        <form action="/search" class="c-search w-form">
          <input class="search-input w-input" maxlength="256" name="query" placeholder="Search the blog…" type="search" id="search" required />
          <input type="submit" class="t_button is-search w-button" value="Search" />
        </form>
      </div>
    </div>
    <BlogHero
      title={item.fieldData.name as string}
      dateText={fmtDate(item.fieldData.date)}
      imageUrl={heroImage(item)}
      categories={categories}
    />
    <BlogContent
      contentHtml={richText(item)}
      authorName={author?.name ?? ''}
      authorSlug={author?.slug ?? ''}
      related={related}
    />
    <BlogTags topics={topics} slider={slider} />
    <SiteFooter variant="main" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
