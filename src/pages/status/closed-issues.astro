---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/status/closed-issues/body.{0,0.post,1}.html; the one CMS list
// (list.0.html, 36 closed radix-opp-statuses items) is rendered from Astro content
// collections, with item SELECTION read from src/bindings/_lists.json's
// "status/closed-issues#0" entry per REBUILD-PLAN.md section 11.
//
// Per-item field resolution reuses src/lib/radix-opp-statuses-detail.ts -- the same
// module src/pages/radix-opp-statuses/[slug].astro already uses -- rather than
// re-deriving it: getServices (the service-s badge repeat), fmtDate, richText and
// dynClass are all proven equivalent to live there.
//
// One field-mapping correction versus src/bindings/_lists.json itself: its slot list
// binds BOTH "Date Reported" and "Last Update" to the `date-reported` field (slots 14
// and 19). Checked against reference/live/status/closed-issues.html, whose 36 items
// show genuinely different Date Reported / Last Update values (e.g. "May 21, 2023" /
// "May 22, 2023") -- the binding-derivation tool missed that the second date comes
// from the item's own `last-update` field instead. _lists.json's ITEM SELECTION (the
// 36 slugs) is still taken as given per the plan; only this one slot's field name is
// corrected here, the same class of fix blog-detail.ts/podcast-detail.ts already
// document for other collections' binding gaps.
//
// The warning icon (status-warning-blue.svg) and the "closed" status-cap-3/
// status-bar-4 markup are literal, not per-item bound: src/bindings/_lists.json has
// no slot for either, and every one of the 36 live items renders the same icon and
// bar (all items in THIS list share status=Closed) -- same reasoning
// RadixOppStatusSection.astro's own comment already recorded for the detail template.
import { readFileSync } from 'node:fs';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import LongformRuntime from '../../components/longform/LongformRuntime.astro';
import { staticListItems } from '../../lib/static-lists';
import { dynClass, fmtDate, richText, getServices } from '../../lib/radix-opp-statuses-detail';

const currentPath = '/status/closed-issues';
const headTail = readFileSync('src/components/status-closed-issues/status-closed-issues-head.html', 'utf8');

const rawIssues = await staticListItems('status/closed-issues#0');
const issues = await Promise.all(rawIssues.map(async (item) => ({
  slug: item.fieldData.slug as string,
  name: (item.fieldData.name as string) ?? '',
  services: await getServices(item),
  dateReportedText: fmtDate(item.fieldData['date-reported']),
  lastUpdateText: fmtDate(item.fieldData['last-update']),
  contentHtml: richText(item),
})));
---
<!doctype html>
<html data-wf-page="69eb0f4c7e09ff521042d6af" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Radix DLT | Services Status | Closed Issues"
      ogTitle="Radix DLT | Services Status | Closed Issues"
      twitterTitle="Radix DLT | Services Status | Closed Issues"
      tail={headTail}
    />
  </head>
  <body>

  <SiteNav variant="status" currentPath={currentPath} />
  <div class="c-section-2">
    <div class="container-2 is-small">
      <div class="c-title-main">
        <h1>Radix Services Status</h1>
      </div>
      <div class="tabs-menu-4">
        <a href="/status/current-issues" class="tab tab-wide w-inline-block">
          <div class="tab-text">Current Issues</div>
        </a> <a href="/status/closed-issues" aria-current="page" class="tab tab-wide w-inline-block w--current">
          <div class="tab-text">Closed Issues</div>
        </a>
      </div>
      <div class="w-dyn-list">
        {issues.length > 0 ? (
          <div role="list" class="w-dyn-items">
            {issues.map((issue) => (
              <div role="listitem" class="w-dyn-item">
                <div class="status-cap-3 closed">
                  <a href={`/radix-opp-statuses/${issue.slug}`} class="status-title-3 w-inline-block"><img loading="lazy" src="/assets/614a0c53de544d060d43ec73_status-warning-blue.svg" alt="" class="status-icon-4" />
                    <h4 class={dynClass('h4-2', !!issue.name)}>{issue.name}</h4>
                  </a>
                  <div class="bm-20">
                    <div class="w-dyn-list">
                      <div role="list" class="collection-list w-dyn-items">
                        {issue.services.map((s) => (
                          <div role="listitem" class="w-dyn-item">
                            <div class={dynClass('badge-3', !!s.name)}>{s.name}</div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                  <div class="bm-20">
                    <div class="status-date-2">
                      <div class="text-small date">Date Reported:</div>
                      <div class="c-date-time">
                        <div class={dynClass('text-small inline', !!issue.dateReportedText)}>{issue.dateReportedText}</div>
                        <div class="text-small">(UTC)</div>
                      </div>
                    </div>
                    <div class="status-date-2">
                      <div class="text-small date">Last Update:</div>
                      <div class="c-date-time">
                        <div class={dynClass('text-small inline', !!issue.lastUpdateText)}>{issue.lastUpdateText}</div>
                        <div class="text-small inline">(UTC)</div>
                      </div>
                    </div>
                  </div>
                  <a href="#" class="c-read-more w-inline-block">
                    <div class="text-small inline"><strong>Read more</strong></div><img loading="lazy" src="/images/arrow.svg" alt="" class="c-arrow" />
                  </a>
                  <div class="c-issue-desc">
                    <div class={dynClass('c-status-rt w-richtext', !!issue.contentHtml)} set:html={issue.contentHtml} />
                  </div>
                  <div class="status-bar-holder">
                    <div class="status-bar-4"></div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state-6 w-dyn-empty">
            <div>There are no closed issues.</div>
          </div>
        )}
      </div>
    </div>
  </div>
  <SiteFooter variant="status" currentPath={currentPath} />
  <LongformRuntime />
  </body>
</html>
