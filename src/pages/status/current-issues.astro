---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/status/current-issues/body.{0,0.post,1}.html.
//
// The one list on this template (list.0.html, "There are no open issues.") is a
// CONFIRMED EMPTY Webflow CMS list -- src/bindings/_lists.json's
// "status/current-issues#0" entry is `{"empty": true}`, and
// reference/live/status/current-issues.html renders only the w-dyn-empty branch
// (there are currently no open Radix service incidents). There is no data to
// resolve; the empty branch is the whole list.
import { readFileSync } from 'node:fs';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import LongformRuntime from '../../components/longform/LongformRuntime.astro';

const currentPath = '/status/current-issues';
const headTail = readFileSync('src/components/status-current-issues/status-current-issues-head.html', 'utf8');
---
<!doctype html>
<html data-wf-page="69eb0b4ab04ce089deabe8ba" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Radix DLT | Services Status"
      description="Radix Operational Status updates."
      ogTitle="Radix DLT | Services Status"
      ogDescription="Radix Operational Status updates."
      twitterTitle="Radix DLT | Services Status"
      twitterDescription="Radix Operational Status updates."
      ogType
      twitterCard
      tail={headTail}
    />
  </head>
  <body>

  <SiteNav variant="status" currentPath={currentPath} />
  <div class="c-section-2">
    <div class="container-2 is-small">
      <div class="c-title-main">
        <h1>Radix Operations Status</h1>
      </div>
      <div class="tabs-menu-4">
        <a href="/status/current-issues" aria-current="page" class="tab tab-wide w-inline-block w--current">
          <div class="tab-text">Current Issues</div>
        </a> <a href="/status/closed-issues" class="tab tab-wide w-inline-block">
          <div class="tab-text">Closed Issues</div>
        </a>
      </div>
      <div class="w-dyn-list">
        <div class="empty-state-5 w-dyn-empty">
          <div>There are no open issues.</div>
        </div>
      </div>
    </div>
  </div>
  <SiteFooter variant="status" currentPath={currentPath} />
  <LongformRuntime />
  </body>
</html>
