---
// The careers detail template, nativised (REBUILD-PLAN.md Phase 4): real Astro markup
// fed by content collections, replacing the DetailPage.astro shell-splicing path for
// this one route. DetailPage/render-detail.mjs/this collection's shell+bindings stay
// in the tree -- other collections still use that path -- but /careers/<slug> no
// longer does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["careers"] already recorded (proven
// static across all 16 items, not per-item data), hardcoded here rather than parsed
// at build time since this route no longer reads that manifest for anything else.
// bodyAttrs is empty for this collection (no attributes on <body>). Unlike
// radix-opp-statuses, this collection's shell DOES carry the banner-wrap block before
// the nav (confirmed against src/shells/_detail/careers/body.html and
// dist/careers/*.html) -- same literal markup blog's page carries, reproduced here
// rather than shared as a component since it's two lines.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/render-detail.mjs';
import { richText } from '../../lib/careers-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import CareerSection from '../../components/careers/CareerSection.astro';

export const getStaticPaths = () => getPaths('careers');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/careers/${slug}`;

const title = resolveHeadTitle('careers', item) ?? 'Radix';
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive. The head tail is genuinely shared across
// collections (byte-identical apart from the canonical URL -- see
// src/components/detail-shared/GenericDetailPage.astro's own note on this), so it's
// read from that shared asset rather than duplicated per collection.
const headTail = readFileSync('src/components/detail-shared/detail-head.html', 'utf8');
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d94e" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head><SiteHead title={title} canonical={`https://www.radixdlt.com${currentPath}`} tail={headTail} /></head>
  <body>
    <div class="banner-wrap">
      <div data-w-id="421cf4db-2453-441c-6135-5b6acee23bfc" class="x-holder x2"><img src="/images/close-1.svg" loading="lazy" alt="" class="imgclose" /></div>
    </div>
    <SiteNav variant="careers" currentPath={currentPath} />
    <CareerSection
      title={item.fieldData.name as string}
      jobSpecHtml={richText(item)}
    />
    <SiteFooter variant="main" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
