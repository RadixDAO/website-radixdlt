---
// The navigation-featured-section detail template, nativised (REBUILD-PLAN.md Phase
// 4, collection `navigation-featured-section`, shape a44f8a4f, 3 pages).
// DetailPage/render-detail.mjs and this collection's shell+bindings stay in the tree
// -- other collections still use that path -- but /navigation-featured-section/<slug>
// no longer does.
//
// This collection is an orphan CMS template like the eight GenericDetailPage.astro
// collections (src/bindings/navigation-featured-section.json has zero slots and its
// three live items render byte-identical <body> content -- confirmed by diffing
// reference/live/navigation-featured-section/*.html directly), but its body is NOT
// content-less the way those eight are: src/shells/_detail/navigation-featured-section/
// body.html carries only `<!--RADIX_NAV_SLOT-->` and the scripts tail -- no banner-wrap,
// no footer, no CMS-bound markup at all. So it doesn't fit GenericDetailPage (which
// renders neither a nav nor SiteNav's own current-marking) and isn't worth a shared
// component of its own, being the only collection with this exact shape -- composed
// inline here, same as careers.astro composes its own page directly.
//
// The `navigation-featured-section` CMS collection is actually what drives the
// "Use / Build / Learn" dropdown panels inside the nav itself (see
// src/chrome/nav.main.html's `dp-group-link` blocks) -- these 3 detail pages are the
// orphaned per-item routes Webflow still publishes for that same collection, unused
// by anything on the live site.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';

export const getStaticPaths = () => getPaths('navigation-featured-section');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/navigation-featured-section/${slug}`;

// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive.
const headTail = readFileSync('src/components/detail-shared/detail-head.html', 'utf8');
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="650a16415183e6fd3dd25ed6" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head><SiteHead title="Radix" canonical={`https://www.radixdlt.com${currentPath}`} tail={headTail} /></head>
  <body>
    <SiteNav variant="main" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
