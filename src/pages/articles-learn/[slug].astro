---
// The articles-learn detail template, nativised (REBUILD-PLAN.md Phase 4): real Astro
// markup fed by content collections, replacing the DetailPage.astro shell-splicing
// path for this one route. DetailPage/render-detail.mjs/the articles-learn shell+bindings
// stay in the tree -- other collections still use that path -- but /articles-learn/<slug>
// no longer does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["articles-learn"] already recorded (proven
// static across all 211 items, not per-item data), hardcoded here rather than parsed at
// build time since this route no longer reads that manifest for anything else. Unlike
// blog, this collection's <head> carries no OG/Twitter meta and no ogType/twitterCard
// (see the manifest entry) -- so SiteHead only gets title + description here.
// The meta description is the article's CATEGORY NAME: that is what reference/live
// carries on all 174 pages (e.g. "Radix Overview"), not the empty string the shell
// pipeline emitted. Confirmed by diffing every live articles-learn page.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/head-title';
import {
  getCategoryName, getAuthor, getGettingStarted, getRelatedArticles,
  articleIcon, richText, likesText, fmtDate, headDescription} from '../../lib/articles-learn-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import ArticleSection from '../../components/articles-learn/ArticleSection.astro';

export const getStaticPaths = () => getPaths('articles-learn');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/articles-learn/${slug}`;

const [categoryName, author, gettingStarted, related] = await Promise.all([
  getCategoryName(item),
  getAuthor(item),
  getGettingStarted(slug),
  getRelatedArticles(slug),
]);

const title = resolveHeadTitle('articles-learn', item) ?? '| The Radix Knowledge Base';
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive.
const headTail = readFileSync('src/components/articles-learn/articles-learn-head.html', 'utf8');
const scriptsTail = readFileSync('src/components/articles-learn/articles-learn-scripts.html', 'utf8');
---
<!doctype html>
<html data-wf-page="69eb1e5730aad0a16f70abd6" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head><SiteHead title={title} description={headDescription(categoryName)} canonical={`https://www.radixdlt.com${currentPath}`} tail={headTail} /></head>
  <body>
    <SiteNav variant="learn" currentPath={currentPath} />
    <ArticleSection
      currentSlug={slug}
      categoryName={categoryName}
      articleIconUrl={articleIcon(item)}
      title={item.fieldData.name as string}
      articleBody={richText(item)}
      author={author}
      lastUpdatedText={fmtDate(item.lastUpdated)}
      likesText={likesText(item)}
      gettingStarted={gettingStarted}
      related={related}
    />
    <SiteFooter variant="learn" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
