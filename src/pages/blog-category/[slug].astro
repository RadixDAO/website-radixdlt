---
// The blog-category detail template, nativised (REBUILD-PLAN.md Phase 4, taxonomy
// shape 44f5fef7, 11 pages): real Astro markup fed by content collections, replacing
// the DetailPage.astro shell-splicing path for this one route. DetailPage/
// render-detail.mjs/this collection's shell+bindings stay in the tree -- other
// collections still use that path -- but /blog-category/<slug> no longer does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["blog-category"] already recorded
// (proven static across all 11 items, not per-item data), hardcoded here rather than
// parsed at build time since this route no longer reads that manifest for anything
// else. bodyAttrs is empty. Unlike blog-author, this collection's shell DOES carry
// the banner-wrap block before the nav (confirmed byte-diffing the two shells) --
// same literal two lines blog's and careers' own pages already carry, reproduced here
// rather than shared as a component since it's two lines.
//
// Shared with blog-author (see src/lib/blog-taxonomy-detail.ts for why): the
// post-list and "explore more topics" blocks. This is the one taxonomy collection
// that self-highlights (see that module's header comment for the aria-current/
// w--current mechanism) -- currentCategorySlug is this page's own slug, since every
// listed post is, by construction, tagged with the category being viewed.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/render-detail.mjs';
import { getTaxonomyPosts, getTaxonomyTopics } from '../../lib/blog-taxonomy-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import BlogCategoryHero from '../../components/blog-category/BlogCategoryHero.astro';
import TaxonomyPostList from '../../components/blog-taxonomy/TaxonomyPostList.astro';
import TaxonomyTopics from '../../components/blog-taxonomy/TaxonomyTopics.astro';

export const getStaticPaths = () => getPaths('blog-category');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/blog-category/${slug}`;

const [posts, topics] = await Promise.all([
  getTaxonomyPosts('blog-category', slug, slug),
  getTaxonomyTopics('blog-category', slug, slug),
]);

const title = resolveHeadTitle('blog-category', item) ?? '| The Radix Blog | Radix DLT';
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive.
const headTail = readFileSync('src/components/detail-shared/detail-head.html', 'utf8')
  .replace('__CANON__', 'https://www.radixdlt.com/detail_blog-category');
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d94d" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head><SiteHead title={title} tail={headTail} /></head>
  <body>
    <div class="banner-wrap">
      <div data-w-id="421cf4db-2453-441c-6135-5b6acee23bfc" class="x-holder x2"><img src="/images/close-1.svg" loading="lazy" alt="" class="imgclose" /></div>
    </div>
    <SiteNav variant="blog" currentPath={currentPath} />
    <div class="search-mobile">
      <div class="container">
        <form action="/search" class="c-search w-form">
          <input class="search-input w-input" maxlength="256" name="query" placeholder="Search the blog…" type="search" id="search" required />
          <input type="submit" class="t_button is-search w-button" value="Search" />
        </form>
      </div>
    </div>
    <BlogCategoryHero item={item} />
    <TaxonomyPostList posts={posts} />
    <TaxonomyTopics
      topics={topics}
      discoverNodeId="w-node-a7a9bb98-71b8-9c88-315b-071ec696eaaf-8a57d94d"
      videoId="a7a9bb98-71b8-9c88-315b-071ec696eac8-video"
    />
    <SiteFooter variant="main" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
