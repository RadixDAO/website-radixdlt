---
// The projects detail template, nativised (REBUILD-PLAN.md Phase 4, collection
// `projects`, shape 7db24134, 28 pages). DetailPage/render-detail.mjs and this
// collection's shell+bindings stay in the tree -- other collections still use that
// path -- but /projects/<slug> no longer does.
//
// See src/components/projects/ProjectsDetailPage.astro's header comment for why this
// collection isn't a fit for GenericDetailPage.astro despite being nearly as thin,
// and src/lib/projects-detail.ts for how its one real content block (the categories
// list) is resolved.
import { getPaths } from '../../lib/content';
import { getCategories } from '../../lib/projects-detail';
import ProjectsDetailPage from '../../components/projects/ProjectsDetailPage.astro';

export const getStaticPaths = () => getPaths('projects');
const { item } = Astro.props;

const categories = await getCategories(item);
---
<ProjectsDetailPage
  collection="projects"
  wfPageId="66dafe27d5486c299a7c9a7d"
  slug={item.fieldData.slug as string}
  categories={categories}
/>
