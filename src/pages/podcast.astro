---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/podcast/body.{0,2,3}.html; the one CMS list (list.2.html, the episode
// cards) is rendered from Astro content collections, with item SELECTION read from
// src/bindings/_lists.json's "podcast#2" entry (5 items) per REBUILD-PLAN.md section
// 11 -- that selection is a snapshot of what Webflow/Finsweet actually rendered and
// isn't reproducible from CMS data alone.
//
// Field mapping verified against reference/live/podcast.html, item by item:
//   - guest photo (div-block-79 img): guest-image asset, always present on all 5
//     items in this list -- matches src/bindings/_lists.json slot 4.
//   - c-podcast-logo img: unbound on every live item (src="" class="w-dyn-bind-empty")
//     -- no slot for it in the binding, left literal.
//   - name -> h4 (slot 10), excerpt -> p.bm-10 (slot 12), href -> /podcast/{slug}
//     (slot 13, via the collection's own detail route).
//   - "Featured" badge: the `featured` Switch field drives Webflow's conditional
//     visibility (w-condition-invisible) -- not in _lists.json's slots at all (that
//     file only captures direct field bindings, not conditions), but confirmed
//     against src/content/podcast/*.json: all 5 items in this list have
//     featured=false, matching live's w-condition-invisible on all 5 cards.
//   - Buzzsprout embed (id + script src): also not in _lists.json's slots (same gap
//     class) -- reproduced via src/lib/podcast-detail.ts's embedId/embedSrc, the
//     same helpers the podcast/[slug].astro detail page already uses and which that
//     module's own comment records as "verified against all 5 live pages".
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import LongformRuntime from '../components/longform/LongformRuntime.astro';
import { staticListItems } from '../lib/static-lists';
import { dynClass, guestImageUrl, embedId, embedSrc } from '../lib/podcast-detail';

const currentPath = '/podcast';
const headTail = readFileSync('src/components/podcast-page/podcast-head.html', 'utf8');

const episodes = await staticListItems('podcast#2');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d9c3" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Podcast | Radix DLT - Decentralized Ledger Technology"
      description="The DeFi Download covers all things about decentralised finance and crypto. Join us as we dive into the details on the projects and assets that are powering the DeFi revolution."
      ogTitle="Podcast | Radix DLT - Decentralized Ledger Technology"
      ogDescription="The DeFi Download covers all things about decentralised finance and crypto. Join us as we dive into the details on the projects and assets that are powering the DeFi revolution."
      ogImage="https://www.radixdlt.com/assets/6259b29982795d7439731a97_Radix-Homepage-Opengraph-1200x1200.png"
      twitterTitle="Podcast | Radix DLT - Decentralized Ledger Technology"
      twitterDescription="The DeFi Download covers all things about decentralised finance and crypto. Join us as we dive into the details on the projects and assets that are powering the DeFi revolution."
      twitterImage="https://www.radixdlt.com/assets/6259b29982795d7439731a97_Radix-Homepage-Opengraph-1200x1200.png"
      ogType
      twitterCard
      skipInvariant
      tail={headTail}
    />
  </head>
  <body>

  <div class="banner-wrap">
    <div data-w-id="421cf4db-2453-441c-6135-5b6acee23bfc" class="x-holder x2"><img src="/images/close-1.svg" loading="lazy" alt="" class="imgclose"></div>
  </div>
  <div class="div-block-5">
    <div class="container"></div>
  </div>
  <SiteNav variant="main" currentPath={currentPath} />
  <div class="c-section">
    <div class="container">
      <div class="c-title-main">
        <div>
          <h1 class="c-title-top no-margin"><span class="c-title-inner">Listen to the revolution</span></h1>
          <h2 class="bm-10">The Radix DeFi podcast<br></h2>
        </div>
        <h4 class="normal-weight">The DeFi Download covers all things about decentralised finance and crypto. Join us as we dive into the details on the projects and assets that are powering the DeFi revolution.</h4>
      </div>
      <div data-w-id="ef4d0e54-4206-3163-f164-d50447e49eab" style="opacity:0" class="div-block-56">
        <div class="div-block-60">
          <div class="div-block-57">
            <div class="div-block-59">
              <h1 class="title-podcast">The DeFi Download</h1>
              <h4 class="normal-weight">with Piers Ridyard<br>CEO, Radix DLT</h4>
            </div>
          </div>
        </div>
        <div class="div-block-58">
          <a href="https://podcasts.apple.com/gb/podcast/the-defi-download/id1513155088" target="_blank" class="t_button is-podcast w-inline-block"><img src="/images/apple.webp" loading="lazy" alt="Apple Podcasts" class="img-button">
            <div>Listen On Apple Podcasts</div>
          </a> <a href="https://open.spotify.com/show/3stSE0dzcf0EXRKmV9baCv" target="_blank" class="t_button is-podcast w-inline-block"><img src="/images/spotify.webp" loading="lazy" alt="Spotify" class="img-button">
            <div>Listen on Spotify</div>
          </a>
        </div>
      </div>
      <div class="w-dyn-list">
        {episodes.length > 0 ? (
          <div role="list" class="w-dyn-items">
            {episodes.map((item) => {
              const slug = item.fieldData.slug as string;
              const name = (item.fieldData.name as string) ?? '';
              const excerpt = (item.fieldData.excerpt as string) ?? '';
              const imageUrl = guestImageUrl(item);
              const featured = !!item.fieldData.featured;
              return (
                <div role="listitem" class="w-dyn-item">
                  <div class="c-podcast-section">
                    <div class="c-podcast-img">
                      <div class="div-block-79"><img src={imageUrl} loading="lazy" alt="" class={dynClass('', !!imageUrl)} /></div>
                    </div>
                    <div class="c-podcast-logo"><img src="" loading="lazy" alt="" class="w-dyn-bind-empty" /></div>
                    <div class="c-podcast-content">
                      <div class="c-podcast-title">
                        <div class={featured ? 'c-featured' : 'c-featured w-condition-invisible'}>Featured</div>
                        <h4 class={dynClass('', !!name)}>{name}</h4>
                      </div>
                      <div class="c-podcast-text">
                        <p class={dynClass('bm-10', !!excerpt)}>{excerpt}</p>
                        <a href={`/podcast/${slug}`}>Full Episode Details</a>
                      </div>
                      <div class="w-embed w-script">
                        <p id={embedId(slug)}></p>
                        <script is:inline src={embedSrc(item, slug)} type="text/javascript" charset="utf-8"></script>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="w-dyn-empty">
            <div>No items found.</div>
          </div>
        )}
      </div>
    </div>
  </div>
  <SiteFooter variant="main" currentPath={currentPath} />
  <LongformRuntime />
  </body>
</html>
