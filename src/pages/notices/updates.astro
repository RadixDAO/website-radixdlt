---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Shares its body with notices.astro via
// src/components/notices/NoticesBody.astro (the "notices x2" family) -- the two
// pages are byte-identical apart from which tab carries the current-page highlight.
import { readFileSync } from 'node:fs';
import SiteHead from '../../components/site/SiteHead.astro';
import NoticesBody from '../../components/notices/NoticesBody.astro';

const currentPath = '/notices/updates';
const headTail = readFileSync('src/components/notices/notices-updates-head.html', 'utf8');
---
<!doctype html>
<html data-wf-page="650a102df8686e2b78a78a64" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Notices - Updates | Radix DLT - Decentralized Ledger Technology"
      ogTitle="Notices - Updates | Radix DLT - Decentralized Ledger Technology"
      twitterTitle="Notices - Updates | Radix DLT - Decentralized Ledger Technology"
      tail={headTail}
    />
  </head>
  <body>
  <NoticesBody current="updates" currentPath={currentPath} />
  </body>
</html>
