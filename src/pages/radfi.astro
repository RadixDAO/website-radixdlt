// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/radfi/body.{0,0.post,1,1.post}.html -- a standalone page shape (not
// shared with any other route). Known-dead RadFi microsite assets (Lottie JSON
// files under /documents/, the embedded YouTube lightbox clips, etc.) are left
// exactly as they were in the shell, per the task brief.
//
// The one CMS list (list.0.html, the "tweets" carousel, radfi-styled variant of
// the same list used by lp/brave/*) is rendered from Astro content collections,
// with item SELECTION read from src/bindings/_lists.json's "radfi#0" entry
// (12 items, 9 live after liveItems() filters out drafts/archived -- matches
// reference/live/radfi.html's rendered count and order exactly). Field VALUES
// resolved live through src/lib/tweets-list.ts, the same module the lp/brave/*
// family uses.
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace
// run that contained a newline in the original shell has been collapsed to a
// single literal space -- both per REBUILD-PLAN.md section 11.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { staticListItems } from '../lib/static-lists';
import { dynClass, tweetContent, tweetName, tweetUrl, avatarStyle } from '../lib/tweets-list';

const currentPath = '/radfi';
const headTail = readFileSync('src/components/radfi/radfi-head.html', 'utf8');

const tweets = await staticListItems('radfi#0');
