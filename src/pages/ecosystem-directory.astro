// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/ecosystem-directory/body.{0,2,3,4,5,6,6.post}.html -- a standalone page
// shape (not shared with any other route).
//
// Four CMS lists, item SELECTION read from src/bindings/_lists.json (Finsweet's
// actual render, not reproducible from CMS data):
//   - list.2 ("ecosystem-directory#2", "project-categories") -- the hero searchbar's
//     category filter checkboxes.
//   - list.3 ("ecosystem-directory#3", "projects-6-highlighted", 6 items) -- the
//     featured-projects carousel.
//   - list.4 ("ecosystem-directory#4", "projects", 28 items) -- the full project
//     grid.
//   - list.5 ("ecosystem-directory#5", "project-categories", 9 items) -- a HIDDEN
//     (div.hide) Finsweet cms-nest SOURCE list: every category's own
//     name/slug, read client-side by cmslibrary-v1.8.js (loaded in
//     body.6.post.html) to populate each project card's own
//     `.projects_item-categories` `fs-cmsnest-element="nest-target"` div --
//     verified against reference/live/ecosystem-directory.html that this div is
//     ALWAYS server-rendered empty on every single project card (Finsweet fills it
//     client-side only), so no per-project category repeat is reproduced here.
//
// GENUINE _lists.json BUG FIXED: "ecosystem-directory#2"'s stored items were
// ["dashboard", null, null, "marketplace", null, null, null, null, "lending"] -- 6 of
// 9 slugs unresolved. reference/live/ecosystem-directory.html's hero filter
// checkboxes actually show ALL 9 categories, in the exact order
// reference/webflow/items/project-categories.json's own collection order lists them
// (dashboard, defi, dex, marketplace, nfts, token, tools, trade, lending) -- which is
// also byte-identical to "ecosystem-directory#5"'s own (already-correct) items array.
// The 3 surviving non-null slugs (dashboard@0, marketplace@3, lending@8) line up
// exactly with that same sequence, confirming position-by-position that the nulls
// are a derivation gap, not a genuine narrower selection -- corrected in
// src/bindings/_lists.json to match #5 exactly.
//
// `fs-cmsfilter*` / `fs-cmsnest*` / `fs-cmsload*` / `fs-cmscombine*` / `fs-cmsstatic*`
// attributes are Finsweet's own client-side filtering hooks and are preserved
// verbatim on every wrapper and per-item element, unchanged from the shell.
//
// `target="_blank"` on the "Explore" link-wrap anchor is NOT in the shell's own
// placeholder (`<a href="#" class="projects_item-link-wrap w-inline-block">`) but IS
// present on all 34 (6+28) matching anchors in reference/live/ecosystem-directory.html
// with zero exceptions -- a Webflow Link-field behavior for this element, added here
// as a constant to match live exactly.
//
// Field VALUES resolved live through Astro content collections (src/lib/content.ts)
// directly -- assetPath()/rewriteAssetUrls() re-exported from detail-data.mjs, same
// as every other nativised template's image/asset handling.
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace run
// that contained a newline in the original shell has been collapsed to a single
// literal space -- both per REBUILD-PLAN.md section 11.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { staticListItems } from '../lib/static-lists';
import { assetPath } from '../lib/content';
import { dynClass } from '../lib/projects-detail';

const currentPath = '/ecosystem-directory';
const headTail = readFileSync('src/components/ecosystem-directory/ecosystem-directory-head.html', 'utf8');

const assetUrl = (img: unknown): string => {
  const url = (img as { url?: string } | null)?.url;
  return url ? assetPath(url) : '';
};

const heroCategoryItems = await staticListItems('ecosystem-directory#2');
const heroCategories = heroCategoryItems.map((item) => ({
  name: (item.fieldData.name as string) ?? '',
}));

const highlightedItems = await staticListItems('ecosystem-directory#3');
const highlighted = highlightedItems.map((item) => ({
  slug: item.fieldData.slug as string,
  bgUrl: assetUrl(item.fieldData['project-background']),
  logoUrl: assetUrl(item.fieldData['project-logo']),
  name: (item.fieldData.name as string) ?? '',
  description: (item.fieldData['project-description'] as string) ?? '',
  linkUrl: (item.fieldData['link-to-project'] as string) ?? '',
}));

const allProjectItems = await staticListItems('ecosystem-directory#4');
const allProjects = allProjectItems.map((item) => ({
  slug: item.fieldData.slug as string,
  bgUrl: assetUrl(item.fieldData['project-background']),
  logoUrl: assetUrl(item.fieldData['project-logo']),
  name: (item.fieldData.name as string) ?? '',
  description: (item.fieldData['project-description'] as string) ?? '',
  linkUrl: (item.fieldData['link-to-project'] as string) ?? '',
}));

const allCategoryItems = await staticListItems('ecosystem-directory#5');
const allCategories = allCategoryItems.map((item) => ({
  slug: item.fieldData.slug as string,
  name: (item.fieldData.name as string) ?? '',
}));
