---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/index/body.{0,2,3,4,4.post}.html -- the site's homepage, a
// standalone page shape not shared with any other route.
//
// Two CMS lists, item SELECTION read from src/bindings/_lists.json (Finsweet's
// actual render, not reproducible from CMS data):
//   - list.2 ("index#2", "ecosystem-projects", 21 items) -- the "Building the
//     Future of Web3 Together" ecosystem-logo slideshow. Each item's template has
//     TWO logo slots (a square "slide-eco-img" and a "slide-eco-img circle"
//     variant); Webflow's own w-condition-invisible toggles which one shows based
//     on the item's OWN `circle-logo` Switch field -- verified item-by-item
//     against reference/live/index.html (e.g. eco-11/eco-8/eco-7/eco-14/
//     shardspace/eco-4 have circle-logo=true and show the circle variant; the
//     other 15 show the square). Reproducing this (rather than always showing one
//     variant) FIXES the task's flagged defect: this page was 6 style="" attrs
//     short of live (46/52) -- WebflowPage's own render only ever emitted one of
//     the two style-bearing divs per item with the OTHER one entirely un-styled
//     (0 style attr) rather than both-styled-but-one-hidden the way live does; now
//     both style attrs are always present (42/42 across 21 items), matching live.
//   - list.3 ("index#3", "full-stack-social-comments", 9 items) -- the community
//     testimonial slider. Field VALUES resolved through src/lib/full-stack-social.ts
//     (the same helpers src/pages/full-stack.astro's own nativised list.2 uses for
//     this collection -- platform Option-id -> discord/twitter/telegram/reddit
//     icon visibility). This page's own markup differs from full-stack's (class
//     "c-inner new-home" here vs "c-inner fs" there) so only the field-resolution
//     helpers are reused, not the markup. `target="_blank"` is added to the
//     testimonial anchor -- absent from the shell's own placeholder but present on
//     all 9 matching reference/live/index.html anchors, zero exceptions (the same
//     Webflow Link-field behavior already documented in ecosystem-directory.astro).
//
// GENUINE _lists.json BUG FIXED: "index#2" stored items were [..., "rns", null,
// "astrolecent", "cacao", ...] and [..., "root-finance-2", null, "eco-14", ...] --
// 2 of 21 slugs null, plus a third slug ("astrolecent") that does not exist in
// reference/webflow/items/ecosystem-projects.json at all (a transcription typo for
// the real slug "astrolescent"). reference/live/index.html's eco-slider shows a
// continuous run of 21 distinct logos with no gaps; matching each rendered
// background-image URL position-by-position against ecosystem-projects.json found
// the two nulls resolve to slug "radix-api" (logo image "1 (1).png") at position 5
// and slug "eco-3" (Ociswap's logo) at position 13, and confirmed "astrolecent"
// should read "astrolescent" (Astrolescent's actual slug, image "Astrolescent
// Logo.png" matches live exactly). Corrected in src/bindings/_lists.json.
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace
// run that contained a newline in the original shell has been collapsed to a
// single literal space -- both per REBUILD-PLAN.md section 11.
//
// Known pre-existing issue, NOT fixed here per instructions: the "Rolling Number"
// countdown script (in the closing script blob below) throws a TypeError on this
// page identically on reference/live -- see reference/KNOWN-BROKEN-ON-LIVE.md.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { staticListItems } from '../lib/static-lists';
import { assetPath } from '../lib/content';
import { platformOf, commentText, commentName, commentUrl, dynClass, iconClass } from '../lib/full-stack-social';

const currentPath = '/';
const headTail = readFileSync('src/components/index/index-head.html', 'utf8');

const assetUrl = (img: unknown): string => {
  const url = (img as { url?: string } | null)?.url;
  return url ? assetPath(url) : '';
};

const ecoItems = await staticListItems('index#2');
const ecoLogos = ecoItems.map((item) => ({
  logoUrl: assetUrl(item.fieldData.logo),
  circle: !!item.fieldData['circle-logo'],
}));

const comments = await staticListItems('index#3');
