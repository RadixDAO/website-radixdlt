viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <path fill-rule="evenodd" clip-rule="evenodd" d="M8.54289 17.9571C8.15237 17.5666 8.15237 16.9334 8.54289 16.5429L13.3358 11.75L8.54289 6.95711C8.15237 6.56658 8.15237 5.93342 8.54289 5.54289C8.93342 5.15237 9.56658 5.15237 9.95711 5.54289L15.4571 11.0429C15.8476 11.4334 15.8476 12.0666 15.4571 12.4571L9.95711 17.9571C9.56658 18.3476 8.93342 18.3476 8.54289 17.9571Z" fill="#ffffff"></path> </svg></div> </a> </div> </div> </div> <div class="div-block-255"></div> </div> <div> <div class="div-block-256"> <h3 class="bm-20">Don’t just take our word for it:</h3> <div class="div-block-262"> <div class="div-block-263"></div> <div class="container"> <div class="slideholder fs w-dyn-list">{comments.length > 0 ? (<div role="list" class="main-slider fs w-clearfix w-dyn-items">{comments.map((item) => { const platform = platformOf(item); return (<div role="listitem" class="carousel-cell fs w-dyn-item"> <div class="c-inner new-home"> <div class={dynClass('tweet-text fs', !!commentText(item))}>{commentText(item)}</div> <a href={commentUrl(item)} target="_blank" class="clip_footer fs w-inline-block"> <div class="tweet_user fs"> <div class="fs-social-img"><img src="/images/discord.svg" loading="lazy" alt="discord logo" class={iconClass(platform, 'discord')}><img src="/images/twitter.svg" loading="lazy" alt="Twitter" class={iconClass(platform, 'twitter')}><img src="/images/telegram.svg" loading="lazy" alt="telegram logo" class={iconClass(platform, 'telegram')}><img src="/images/reddit.webp" loading="lazy" alt="Reddit Logo" class={iconClass(platform, 'reddit')}></div> <div class="fs-link-social"> <div class={dynClass('', !!commentName(item))}>{commentName(item)}</div> </div> </div> </a> </div> </div>); })} </div>) : (<div class="w-dyn-empty"> <div>No items found.</div> </div>)} </div> </div> </div> </div> </div> </div> <div class="mesh-holder purple"> <div data-poster-url="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-poster-00001.jpg" data-video-urls="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.mp4,/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" data-beta-bgvideo-upgrade="false" class="mesh-vid-2 z5 w-background-video w-background-video-atom"><video id="7e016fd2-e4c8-e044-1e3b-43d668a07d28-video" autoplay="" loop="" style="background-image:url(&quot;/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-poster-00001.jpg&quot;)" muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover"> <source src="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.mp4" data-wf-ignore="true"> <source src="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.webm" data-wf-ignore="true"> </video></div> </div> </div> </div> </div> <div class="c-section"> <div id="the-community" class="page-anchor"></div> <div class="container div-block-253"> <div class="div-block-254"> <div class="c-title-span">Radix Community</div> <h2 class="bm-20">Building the Future of Web3 Together</h2> <div class="mw-640">Join a passionate, ready-to-help community of users, developers, and entrepreneurs already using and building on Radix.</div> </div> </div> <div class="w-embed"> <style is:inline>
