---
// The projects-6-highlighted detail template, nativised (REBUILD-PLAN.md Phase 4,
// collection `projects-6-highlighted`, shape 136e190a, 8 pages). DetailPage/
// render-detail.mjs and this collection's shell+bindings stay in the tree -- other
// collections still use that path -- but /projects-6-highlighted/<slug> no longer
// does.
//
// Shares its shell/component with `projects` -- see
// src/components/projects/ProjectsDetailPage.astro's header comment.
import { getPaths } from '../../lib/content';
import { getCategories } from '../../lib/projects-detail';
import ProjectsDetailPage from '../../components/projects/ProjectsDetailPage.astro';

export const getStaticPaths = () => getPaths('projects-6-highlighted');
const { item } = Astro.props;

const categories = await getCategories(item);
---
<ProjectsDetailPage
  collection="projects-6-highlighted"
  wfPageId="66e2c7c4f223104818b694f1"
  slug={item.fieldData.slug as string}
  categories={categories}
/>
