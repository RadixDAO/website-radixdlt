---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/full-stack/body.{0,2,3,3.post}.html -- a standalone page shape (not
// shared with any other route).
//
// The one CMS list (list.2.html, the "full-stack-social-comments" carousel) is
// rendered from Astro content collections, with item SELECTION read from
// src/bindings/_lists.json's "full-stack#2" entry (9 items, all live -- matches
// reference/live/full-stack.html's rendered count and order exactly). Field
// VALUES resolved live through src/lib/full-stack-social.ts: each card shows all
// four static platform icons with only the item's own platform left visible (the
// other three carry w-condition-invisible), matched against
// reference/webflow/fields/full-stack-social-comments.json's own Option-id list
// and verified item-by-item against reference/live/full-stack.html.
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace
// run that contained a newline in the original shell has been collapsed to a
// single literal space -- both per REBUILD-PLAN.md section 11.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { staticListItems } from '../lib/static-lists';
import { platformOf, commentText, commentName, commentUrl, dynClass, iconClass } from '../lib/full-stack-social';

const currentPath = '/full-stack';
const headTail = readFileSync('src/components/full-stack/full-stack-head.html', 'utf8');

const comments = await staticListItems('full-stack#2');
