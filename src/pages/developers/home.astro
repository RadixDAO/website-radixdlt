---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup below is lifted verbatim from
// src/shells/developers/home/body.{0,0.post,1..8}.html -- at 225,793 raw shell
// bytes, the biggest single page in the project -- and kept as literal template
// content: every <style>/<script> carries is:inline, and every inter-tag
// whitespace run that contained a newline in the original shell has been collapsed
// to a single literal space, both per REBUILD-PLAN.md section 11.
//
// A genuine (pre-existing, NOT introduced here) shell defect was fixed while
// copying: 7 video-poster `style="background-image:url(...)"` attributes in
// body.0.post.html/body.2.html/body.3.html/body.6.html/body.7.html/body.8.html read
// literally `url(/developers&quot;/assets/<file>&quot;)` -- an extra "/developers"
// substring wedged in front of the opening &quot;, present in the shell on disk and
// already shipping identically in the current WebflowPage.astro-rendered
// dist/developers/home.html. The correctly-mirrored local assets
// (public/assets/<file>, matching reference/live's CDN URLs by filename) already
// exist; the bug was purely a mis-rewritten href with no missing asset behind it,
// so corrected to `url(&quot;/assets/<file>&quot;)` here, matching every other
// already-nativised page's identical video-poster pattern (e.g. index.astro).
//
// The tracking/embed block (body.0.html's leading "developers---codes" div) and the
// runtime script tail (body.8.html's tail from the jQuery <script> on) are byte-
// identical to the other developers/* shells (is:inline aside), so they're factored
// into DevelopersTrackingCodes.astro / DevelopersRuntime.astro instead of duplicated
// here. body.0.html carries two EXTRA <style> blocks (marquee-loop keyframes for
// ".slideshow-items-container" and ".first") after the tracking codes that are NOT
// part of that shared component -- kept inline, verbatim. Nav/footer variant is
// "developers-nested" (not plain "developers" -- that's developers/ecosystem), per
// src/shells/manifest.json, which is what the current WebflowPage.astro render
// already uses for this route.
//
// 8 CMS lists total, but only list.0/list.1 ("ecosystems-developers", 18 items each
// -- two identical marquee tracks of the same logo sequence, per _lists.json) carry
// content. list.2 through list.7 are ALL CONFIRMED EMPTY on live -- verified
// directly: reference/live/developers/home.html contains exactly 8 `w-dyn-list`
// occurrences and exactly 6 `w-dyn-empty` occurrences, i.e. 6 of the 8 lists render
// nothing but the "No items found." branch (Webflow omits the `w-dyn-items` wrapper
// entirely when a list is empty, not merely CSS-hides it) -- list.2/list.7 are the
// "Don't just take our word for it" testimonial slider (appears twice in this page's
// markup), list.3/list.4/list.5 are the hidden secondary nav's own per-section
// featured-link lists ("The Radix Wallet" / "Start here" / "HIGHLIGHTS"), and
// list.6 is the eco-slider. src/bindings/_lists.json already marks all six
// `{"empty": true}`, which src/lib/static-lists.ts renders as the empty branch with
// no special-casing needed here.
//
// list.0/list.1's 18-item order (eco-1, eco-10..eco-17, eco-19, eco-2..eco-9 -- i.e.
// lexicographic slug order, not numeric) was checked against
// reference/live/developers/home.html's own sequence of rendered
// background-image logo URLs and matches exactly, position-by-position, on both
// tracks -- no null/duplicate/misspelled slug this time, unlike the last three
// batches' _lists.json findings elsewhere.
import { readFileSync } from 'node:fs';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import DevelopersTrackingCodes from '../../components/developers/DevelopersTrackingCodes.astro';
import DevelopersRuntime from '../../components/developers/DevelopersRuntime.astro';
import { staticListItems } from '../../lib/static-lists';
import { assetPath, type CmsItem } from '../../lib/content';

const currentPath = '/developers/home';
const headTail = readFileSync('src/components/developers/developers-head.html', 'utf8');

const ecoLogo = (item: CmsItem): string =>
  assetPath((item.fieldData.logo as { url?: string } | undefined)?.url ?? '');

const ecoItems0 = await staticListItems('developers/home#0');
const ecoItems1 = await staticListItems('developers/home#1');
const list2 = await staticListItems('developers/home#2');
const list3 = await staticListItems('developers/home#3');
const list4 = await staticListItems('developers/home#4');
const list5 = await staticListItems('developers/home#5');
const list6 = await staticListItems('developers/home#6');
const list7 = await staticListItems('developers/home#7');
---
<!doctype html>
<html data-wf-page="69ee5a8156976a283cdb888b" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Radix - Developer Hub"
      description="Radix&#x27;s developer hub with everything you need to get started building DeFi with Scrypto."
      ogTitle="Radix - Developer Hub"
      ogDescription="Radix&#x27;s developer hub with everything you need to get started building DeFi with Scrypto."
      twitterTitle="Radix - Developer Hub"
      twitterDescription="Radix&#x27;s developer hub with everything you need to get started building DeFi with Scrypto."
      ogType
      twitterCard
      canonical="https://www.radixdlt.com/developers/home"
      tail={headTail}
    />
  </head>
  <body>
<DevelopersTrackingCodes /><div class="w-embed"> <style is:inline>
.slideshow-items-container {
  position: static;
  will-change: transform;
  animation: marquee-horizontal 20s linear infinite;
  /* manipulate the speed of the marquee by changing "40s" line above*/
}
@keyframes marquee-horizontal {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
