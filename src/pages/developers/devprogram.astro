---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup below is lifted verbatim from
// src/shells/developers/devprogram/body.{0,0.post,0.post.post}.html and kept as
// literal template content -- every <style>/<script> in it carries is:inline,
// which is what makes Astro round-trip Webflow markup byte-identically (see the
// plan): without is:inline, Astro stamps data-astro-cid on every element and
// rewrites the jQuery/Flickity CDN <script> tags into its own module bundles.
//
// Unlike the other 6 developers/* routes, this page's tracking/embed block sits
// AFTER the footer (its body.0.post.post.html opens with the same
// DevelopersTrackingCodes content, then the same DevelopersRuntime tail, then
// devprogram's own unique Auth0/HubSpot signup-flow script -- verified as a
// verbatim substring match against the other 6 shells). This page also uses the
// developers-nested nav variant, not developers.
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import DevelopersTrackingCodes from '../../components/developers/DevelopersTrackingCodes.astro';
import DevelopersRuntime from '../../components/developers/DevelopersRuntime.astro';
import { readFileSync } from 'node:fs';

const currentPath = '/developers/devprogram';
const headTail = readFileSync('src/components/developers/devprogram-head.html', 'utf8');
