---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup below is lifted verbatim from
// src/shells/developers/sign-up/body.{0,0.post,0.post.post}.html and kept as
// literal template content -- every <style>/<script> in it carries is:inline,
// which is what makes Astro round-trip Webflow markup byte-identically (see the
// plan): without is:inline, Astro stamps data-astro-cid on every element and
// rewrites the jQuery/Flickity CDN <script> tags into its own module bundles.
//
// The tracking/embed block (body.0.html) and the runtime script tail
// (body.0.post.post.html) are byte-identical to grants/submit-blueprint/the three
// developers/lp/* shells, so they're factored into DevelopersTrackingCodes.astro
// and DevelopersRuntime.astro instead of duplicated per route.
//
// This page has a known-broken div#auth-form left over from a removed Auth0
// widget wire-up -- moved verbatim per the task brief (not "fixed").
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import DevelopersTrackingCodes from '../../components/developers/DevelopersTrackingCodes.astro';
import DevelopersRuntime from '../../components/developers/DevelopersRuntime.astro';
import { readFileSync } from 'node:fs';

const currentPath = '/developers/sign-up';
const headTail = readFileSync('src/components/developers/developers-head.html', 'utf8');
---
<!doctype html>
<html data-wf-page="69ee5f5fb8fa1fe493d913ec" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Radix - Developer Program - Signup Form"
      description="Sign up to the Radix Developers Program for the latest on Scrypto and developer events."
      ogTitle="Radix - Developer Program - Signup Form"
      ogDescription="Sign up to the Radix Developers Program for the latest on Scrypto and developer events."
      twitterTitle="Radix - Developer Program - Signup Form"
      twitterDescription="Sign up to the Radix Developers Program for the latest on Scrypto and developer events."
      ogType
      twitterCard
      canonical="https://www.radixdlt.com/developers/sign-up"
      tail={headTail}
    />
  </head>
  <body>
    <DevelopersTrackingCodes />
    <SiteNav variant="developers" currentPath={currentPath} />

  <div class="c-section-sticky">
    <div class="container-sticky is-small">
      <div class="c-title-main-3">
        <h2 class="bm_40">Radix Developer Program</h2>
      </div>
    </div>
    <div class="container-sticky is-medium">
      <div id="auth-form"></div>
    </div>
  </div>
    <SiteFooter variant="developers" currentPath={currentPath} />
    <DevelopersRuntime />
  </body>
</html>
