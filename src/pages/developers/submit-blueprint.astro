---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup below is lifted verbatim from
// src/shells/developers/submit-blueprint/body.{0,0.post,0.post.post}.html and kept
// as literal template content -- every <style>/<script> in it carries is:inline,
// which is what makes Astro round-trip Webflow markup byte-identically (see the
// plan): without is:inline, Astro stamps data-astro-cid on every element and
// rewrites the jQuery/Flickity CDN <script> tags into its own module bundles.
//
// The tracking/embed block (body.0.html) and the runtime script tail
// (body.0.post.post.html) are byte-identical to grants/sign-up/the three
// developers/lp/* shells, so they're factored into DevelopersTrackingCodes.astro
// and DevelopersRuntime.astro instead of duplicated per route.
//
// The <form id="Submit-DeFi-Blueprint"> below has no action attribute (Webflow-
// hosted form submission was never wired up) -- moved verbatim per the task brief,
// known-broken at cutover, not "fixed".
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import DevelopersTrackingCodes from '../../components/developers/DevelopersTrackingCodes.astro';
import DevelopersRuntime from '../../components/developers/DevelopersRuntime.astro';
import { readFileSync } from 'node:fs';

const currentPath = '/developers/submit-blueprint';
const headTail = readFileSync('src/components/developers/developers-head.html', 'utf8');
---
<!doctype html>
<html data-wf-page="69ee5f3386024e5695911138" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Radix - DeFi Ecosystem - Submit Blueprint"
      description="Submit your Blueprint. The future of DeFi is being built with Scrypto. See the expanding Radix ecosystem, and submit your own blueprints."
      ogTitle="Radix - DeFi Ecosystem - Submit Blueprint"
      ogDescription="Submit your Blueprint. The future of DeFi is being built with Scrypto. See the expanding Radix ecosystem, and submit your own blueprints."
      twitterTitle="Radix - DeFi Ecosystem - Submit Blueprint"
      twitterDescription="Submit your Blueprint. The future of DeFi is being built with Scrypto. See the expanding Radix ecosystem, and submit your own blueprints."
      ogType
      twitterCard
      canonical="https://www.radixdlt.com/developers/submit-blueprint"
      tail={headTail}
    />
  </head>
  <body>
    <DevelopersTrackingCodes />
    <SiteNav variant="developers" currentPath={currentPath} />

  <div class="c-section-sticky">
    <div class="container-sticky is-small top">
      <div class="c-blueprint-form w-form">
        <form id="Submit-DeFi-Blueprint" name="wf-form-Submit-DeFi-Blueprint" data-name="Submit DeFi Blueprint" method="get" data-wf-page-id="69ee5f3386024e5695911138" data-wf-element-id="5ce1de09-d58b-6310-b43f-6dde6ecdd32f">
          <div class="form-title">
            <div class="bm-10-4">
              <h2>Submit your DeFi Blueprint</h2>
            </div>
            <div>
              <h4 class="heading-10">We’re excited to see what you’ve built!</h4>
            </div>
          </div>
          <div class="bm_40"><label for="Name" class="field-label">Full name</label><input class="w-input" autofocus="true" maxlength="256" name="Name" data-name="Name" placeholder="Enter your full name" type="text" id="Name" required=""></div>
          <div class="bm_40"><label for="Email" class="field-label">Contact Email ADDRESS</label><input class="w-input" maxlength="256" name="Email" data-name="Email" placeholder="Enter your email address" type="email" id="Email" required=""></div>
          <div class="bm_40"><label for="blueprint-category" class="field-label">Blueprint Category</label><select id="blueprint-category" name="Blueprint-Category" data-name="Blueprint Category" required="" class="w-select">
              <option value="">Select the category your project belongs in</option>
              <option value=" Decentralized Exchanges"> Decentralized Exchanges</option>
              <option value=" Stablecoins"> Stablecoins</option>
              <option value=" Lending &amp; Money Markets"> Lending &amp; Money Markets</option>
              <option value=" Insurance"> Insurance</option>
              <option value=" Futures, Options, &amp; Derivatives"> Futures, Options, &amp; Derivatives</option>
              <option value=" Portfolio Management &amp; Yield Farming"> Portfolio Management &amp; Yield Farming</option>
              <option value=" NFT"> NFT</option>
              <option value=" Gaming"> Gaming</option>
              <option value=" Oracles"> Oracles</option>
              <option value=" Wallets &amp; Dashboards"> Wallets &amp; Dashboards</option>
              <option value=" Other"> Other</option>
            </select></div>
          <div class="bm_40"><label for="github-Link" class="field-label">GITHUB Link</label><input class="w-input" maxlength="256" name="Github-Link" data-name="Github Link" placeholder="Enter the Github URL" type="text" id="github-Link" required=""></div>
          <div class="bm_40"><label for="Description" class="field-label">Description</label><textarea id="Description" name="Description" maxlength="5000" placeholder="Tell us about your project here" required="" data-name="Description" class="input is-ta w-input"></textarea></div><input type="submit" data-wait="Please wait..." class="t_button-2 is-extended w-button" value="Submit">
        </form>
        <div class="success-message-4 w-form-done">
          <div class="bm-20">
            <h2>Thank You for Submitting <br>Your DeFi Blueprint</h2>
          </div>
          <div class="bm_40">
            <div>We’ll be in touch about listing on the Radix Ecosystem page after we’ve had a chance to review your subsmission.</div>
          </div>
          <div class="flex-default bm-20">
            <div class="c_button-inline">
              <a href="#" class="t_button-2 is-extended">Take me back to the Radix Ecosystem</a>
            </div>
          </div>
        </div>
        <div class="error-message w-form-fail">
          <div>Oops! Something went wrong while submitting the form.</div>
        </div>
      </div>
    </div>
  </div>
    <SiteFooter variant="developers" currentPath={currentPath} />
    <DevelopersRuntime />
  </body>
</html>
