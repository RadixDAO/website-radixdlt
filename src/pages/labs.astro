// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/labs/body.{0,0.post,1,2,3,4,5}.html -- a standalone page shape not
// shared with any other route.
//
// Five CMS lists, item SELECTION read from src/bindings/_lists.json (Finsweet's
// actual render, not reproducible from CMS data):
//   - list.0/1 ("labs#0"/"labs#1", "partners", 8 items each, IDENTICAL selection
//     and order -- two copies of the same logo track for a CSS marquee loop,
//     verified against reference/live/labs.html: both `parners_slider-track`
//     wrappers render the same 8 logos in the same order, including slug
//     "parner" appearing TWICE within a single track (position 0 and 3) --
//     matches live exactly, not a dedup bug.
//   - list.2/3 ("labs#2"/"labs#3", "featured-on", 7 items each, identical pair,
//     same marquee pattern) -- the "Featured on" press-logo track.
//   - list.4 ("labs#4", "testemonials", 7 items) -- the testimonial slider.
//     INVESTIGATED, no fix needed: the stored items are six copies of slug
//     "jamie-diamond" plus one "jamie-diamond-copy-5". Checked against
//     reference/webflow/items/testemonials.json: all 7 "jamie-diamond*" CMS items
//     are placeholder content with byte-identical name/content/image (bar
//     "-copy-5", which differs only by a re-uploaded asset id for the SAME
//     image), so rendering the stored (imprecise) slug sequence is byte-identical
//     to the "correct" 7 distinct slugs -- confirmed against
//     reference/live/labs.html's own 6-slide (deduplicated-by-Swiper-loop)
//     testimonial markup. Left as-is since there is no observable difference to
//     fix.
//
// Partner/featured-on logos use dynClass (src/lib/blog-detail.ts) to drop/restore
// the shell's own `w-dyn-bind-empty` marker on the <img>, matching
// reference/live/labs.html exactly -- render-list.mjs's own approximation never
// touched this attr:src-bound class (it only strips w-dyn-bind-empty for inner/html
// bindings), which is one of the pre-existing gaps this nativisation replaces with
// a byte-accurate rule instead of reproducing the approximation's own blind spot.
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace
// run that contained a newline in the original shell has been collapsed to a
// single literal space -- both per REBUILD-PLAN.md section 11.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { staticListItems } from '../lib/static-lists';
import { assetPath } from '../lib/content';
import { dynClass } from '../lib/blog-detail';

const currentPath = '/labs';
const headTail = readFileSync('src/components/labs/labs-head.html', 'utf8');

const assetUrl = (img: unknown): string => {
  const url = (img as { url?: string } | null)?.url;
  return url ? assetPath(url) : '';
};

const loadLogos = async (key: string) => {
  const items = await staticListItems(key);
  return items.map((item) => ({ logoUrl: assetUrl(item.fieldData.logo) }));
};

const partners1 = await loadLogos('labs#0');
const featuredOn1 = await loadLogos('labs#2');

const testimonialItems = await staticListItems('labs#4');
const testimonials = testimonialItems.map((item) => ({
  imageUrl: assetUrl(item.fieldData.image),
  content: (item.fieldData.content as string) ?? '',
  name: (item.fieldData.name as string) ?? '',
}));
