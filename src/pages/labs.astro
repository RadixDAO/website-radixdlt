 <div class="page-wrapper-2"> <div class="code-embed-12 w-embed w-script"> <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // Get references to the text element, divs, and output
    const inputText = document.getElementById('inputText');
    const output = document.getElementById('output');
    const minusDiv = document.getElementById('minusDiv');
    const plusDiv = document.getElementById('plusDiv');
    // Set the initial values
    const stepInput = 256;
    const stepOutput = 100000;
    let currentInputValue = stepInput; // Start at 256
    let currentOutputValue = stepOutput; // Start at 100,000
    updateDisplay(currentOutputValue);
    // Function to animate number rolling
    function animateNumber(start, end, duration, callback) {
      let startTime = null;
      function step(timestamp) {
        if (!startTime) startTime = timestamp;
        const progress = Math.min((timestamp - startTime) / duration, 1);
        const currentValue = Math.floor(progress * (end - start) + start);
        callback(currentValue);
        if (progress < 1) {
          requestAnimationFrame(step);
        }
      }
      requestAnimationFrame(step);
    }
    // Function to update the text element and output
    function updateDisplay(newOutputValue) {
      inputText.textContent = currentInputValue;
      animateNumber(currentOutputValue, newOutputValue, 500, function(animatedValue) {
        output.textContent = animatedValue.toLocaleString('en-US', { minimumFractionDigits: 0 });
      });
      currentOutputValue = newOutputValue; // Update the current output value
    }
    // Add event listeners to divs
    minusDiv.addEventListener('click', function() {
      if (currentInputValue > stepInput) {
        currentInputValue = Math.max(currentInputValue - stepInput, 0); // Prevent negative values
        const newOutputValue = (currentInputValue / stepInput) * stepOutput;
        updateDisplay(newOutputValue);
      }
    });
    plusDiv.addEventListener('click', function() {
      currentInputValue += stepInput;
      const newOutputValue = (currentInputValue / stepInput) * stepOutput;
      updateDisplay(newOutputValue);
    });
  });
