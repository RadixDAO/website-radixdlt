  <script is:inline>
	// setup
  const a             = 10;
  const b             = Math.pow(a, 1/a);
  let StakeApi;
  let stakeCheck			= true;
  let xrdPool;
  let radixPrice;
  let priceCheck      = false;
  let yMax;
  let yMin;
  let yMinPercent;
  let yMaxPercent;
  const dailyFixed    = 821917;
  const monthlyFixed  = 25000000;
  const yearlyFixed   = 300000000;
  // Prices Convert format
  function convertNumber(labelValue, fixed = 2) {
    const n = Number(labelValue);
    if (!isFinite(n)) return "0";
    if (Math.abs(n) < 1) {
      const decimals = Math.max(fixed, 5);
      return n.toFixed(decimals);
    }
    // Nine Zeroes for Billions
    return Math.abs(n) >= 1.0e+9
      ? (Math.abs(n) / 1.0e+9).toFixed(fixed) + "B"
    // Six Zeroes for Millions 
    : Math.abs(n) >= 1.0e+6
      ? (Math.abs(n) / 1.0e+6).toFixed(fixed) + "M"
    // Three Zeroes for Thousands
    : Math.abs(n) >= 1.0e+3
      ? (Math.abs(n) / 1.0e+3).toFixed(fixed) + "K"
    : Math.abs(n).toFixed(fixed);
  }
  function numFormart(val) {
    while (/(\d+)(\d{3})/.test(val.toString())){
      val = val.toString().replace(/(\d+)(\d{3})/, '$1'+','+'$2');
    }
    return val;
  }
  // staking calc track
  for (let e of document.querySelectorAll('input[type="range"].slider-progress')) {
    e.style.setProperty('--value', e.value);
    e.style.setProperty('--min', e.min == '' ? '0' : e.min);
    e.style.setProperty('--max', e.max == '' ? '100' : e.max);
    e.addEventListener('input', () => e.style.setProperty('--value', e.value));
  }
  if (stakingManual != true) {
    $.ajax("https://stats.radixdlt.com/witness/staked-tokens", {
      method: "GET",
      headers: {"Accept": "application/json"},
      dataType: "json",
      async: false,
      success: (content) => {
        var obj_id = content["data"].length - 2;
        if (isNaN(content["data"][obj_id]["total_staked_tokens"]) || 
            typeof content["data"][obj_id]["total_staked_tokens"] == 'undefined' || 
            content["data"][obj_id]["total_staked_tokens"] < 1) 
        {
          StakeApi = stakingManualNumber;
          stakeCheck = true;
          updateYearlyReward();
        } else {
          StakeApi = content["data"][obj_id]["total_staked_tokens"];
          stakeCheck = true;
          updateYearlyReward();
        }
      },
      error: (xhr, textStatus, errorThrown) => {
        console.log(textStatus, errorThrown);
      }
    });
  } else {
      StakeApi = stakingManualNumber;
      stakeCheck = true;
      updateYearlyReward();
  }
  $.ajax("https://api.coingecko.com/api/v3/simple/price?ids=radix,e-radix&vs_currencies=usd&include_market_cap=true&include_24hr_vol=true", {
    method: "GET",
    headers: {"Accept": "application/json"},
    dataType: "json",
    async: false,
    success: (data) => {
      radixPrice = data["radix"]["usd"];
      priceCheck = true;
      updateContent();
      xrdPool = radixPrice * yearlyFixed;
      $(".xrdpool").text(convertNumber(xrdPool, 0));
      var tVolume = data["radix"]["usd_24h_vol"] + data["e-radix"]["usd_24h_vol"];
      $(".usd").append(convertNumber(data["radix"]["usd"]));
      $(".market-cap").append(convertNumber(data["radix"]["usd_market_cap"]));
      $(".volume").append(convertNumber(tVolume));
    },
    error: (xhr, textStatus, errorThrown) => {
      console.log(textStatus, errorThrown);
    }
  });
  function updateYearlyReward() {
  	if(stakeCheck) {
      yMax = 300000000 / StakeApi;
      yMin = 0.95 * yMax; 
      yMinPercent   = yMin*100;
      yMaxPercent   = yMax*100; 
      $("#y-min").text(yMinPercent.toFixed(0));
      $("#y-max").text(yMaxPercent.toFixed(0));
      $("#stakingPercent").text(yMaxPercent.toFixed(0));
     	$("#stakeHero").css( "opacity", "1" );
    } else {}
  }
  function updateContent() {
    // update stake
    let calc = Math.floor(a * Math.pow(b, $("#input").val()));
    $("#output").text(numFormart(calc));
		if(stakeCheck && priceCheck) {
      // daily stake
      let daily = dailyFixed * (calc/StakeApi);
      let dailyPrice = daily * radixPrice;
      $("#daily .xrd").text(numFormart(daily.toFixed(2)));
      // monthly stake
      let monthly = monthlyFixed * (calc/StakeApi);
      let monthlyPrice = monthly * radixPrice;
      $("#monthly .xrd").text(numFormart(monthly.toFixed(2)));
      // yearly stake
      let yearly = yearlyFixed * (calc/StakeApi);
      let yearlyPrice = yearly * radixPrice;
      $("#yearly .xrd").text(numFormart(yearly.toFixed(2)));
      $("#daily .price").text(numFormart(dailyPrice.toFixed(2)));
      $("#monthly .price").text(numFormart(monthlyPrice.toFixed(2)));
      $("#yearly .price").text(numFormart(yearlyPrice.toFixed(2)));
    } else {
    	$("#stakeBtnHero, #stakeBtnMenu, #staking").hide();
    }
  }
  // slider listener
  $("#input").on("mousemove touchmove keydown", function() { updateContent() });
</script>
