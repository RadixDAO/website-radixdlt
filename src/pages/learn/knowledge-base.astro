---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/learn/knowledge-base/body.{0,0.post,1,2,3,4,4.post}.html -- a standalone
// page shape (not shared with any other route).
//
// Four CMS lists, item SELECTION read from src/bindings/_lists.json (Finsweet's
// actual render, not reproducible from CMS data):
//   - list.0 ("learn/knowledge-base#0", 3 items, "articles-learn") -- the hero's
//     "Start Here!" quick-link buttons.
//   - list.1 ("learn/knowledge-base#1", 100 items, "articles-learn") -- a HIDDEN list
//     (search-terms-wrapper starts display:none) whose <p class="autofill-title">
//     text is read client-side by the inline search-autocomplete script in
//     body.4.post.html; never visually rendered itself.
//   - list.2 ("learn/knowledge-base#2", 5 items, "categories-learn") -- the "Getting
//     started" category cards (icon/name/question count).
//   - list.3 ("learn/knowledge-base#3", 5 items, "articles-learn") -- the "Featured
//     Questions" links, matching the shape src/components/learn-taxonomy/QuestionList.astro
//     already established for categories-learn/sub-categories-learn (same classes:
//     collection-list-wrapper-3, featured-question-link, icon-3, text-18px) -- not
//     reused directly since that component's item selection comes from a different
//     bindings file (detail-lists/*.json, per-taxonomy-term) while this page's comes
//     from _lists.json (per-route), but the per-item markup and field names
//     (slug/icon/name) are the same CMS shape, cross-checked against
//     reference/live/learn/knowledge-base.html.
//
// Field VALUES resolved live through src/lib/articles-learn-detail.ts (articleIcon,
// dynClass) and src/lib/categories-learn-detail.ts (categoryIcon) -- the same helpers
// the nativised articles-learn/categories-learn detail templates already use.
//
// `alt={'search icon\n'}` / `alt={'telegram icon\n'}` / `alt={'mail icon\n'}` carry a
// literal embedded newline verified present byte-for-byte in reference/live (Webflow's
// own export quirk, not a mistake) -- written as a JS string expression rather than a
// raw newline inside a quoted HTML attribute, same convention
// src/components/learn-taxonomy/QuestionList.astro already uses for its own
// `alt={'file icon\n'}`. This is why body.0.post.html/body.4.html were run through a
// newline-in-attribute-safe whitespace collapse instead of the plain one: the general
// inter-tag collapse rule (REBUILD-PLAN.md section 11) must never touch a newline
// that lives inside an attribute VALUE, only ones between tags.
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace run
// that contained a newline in the original shell has been collapsed to a single
// literal space -- both per REBUILD-PLAN.md section 11.
import { readFileSync } from 'node:fs';
import { getCollection } from 'astro:content';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { staticListItems } from '../../lib/static-lists';
import { articleIcon, dynClass } from '../../lib/articles-learn-detail';
import { categoryIcon } from '../../lib/categories-learn-detail';

const currentPath = '/learn/knowledge-base';
const headTail = readFileSync('src/components/learn-knowledge-base/knowledge-base-head.html', 'utf8');

const gettingStartedItems = await staticListItems('learn/knowledge-base#0');
const gettingStarted = gettingStartedItems.map((item) => ({
  slug: item.fieldData.slug as string,
  title: (item.fieldData.name as string) ?? '',
}));

// list.1 ("Explore more topics" autofill source) is the one list on this page where
// 8 of its 100 selected slugs (e.g. "whats-an-epoch-2") are marked isArchived in the
// current CMS snapshot, yet reference/live/learn/knowledge-base.html still lists
// their names verbatim in the hidden autofill-title source -- Finsweet's own render
// of this particular list evidently doesn't drop archived items the way a live
// DETAIL PAGE would (there's no page being routed to here, just raw text read by the
// client-side search script). staticListItems()/liveItems() intentionally filters
// draft+archived (matching Webflow's own "can't build a page for this" rule for
// every other list on the site), so this one list resolves against the full,
// unfiltered collection instead to match live exactly.
const allArticlesCollectionItems = await getCollection('articles-learn');
const allArticlesBySlug = new Map(allArticlesCollectionItems.map((e) => [(e.data as { fieldData: Record<string, unknown> }).fieldData.slug as string, e.data as { fieldData: Record<string, unknown> }]));
const allArticlesEntry = JSON.parse(readFileSync('src/bindings/_lists.json', 'utf8'))['learn/knowledge-base#1'];
const allArticles = ((allArticlesEntry?.items as string[]) ?? [])
  .map((slug) => allArticlesBySlug.get(slug))
  .filter((item): item is { fieldData: Record<string, unknown> } => !!item)
  .map((item) => ({ title: (item.fieldData.name as string) ?? '' }));

const gettingStartedCatItems = await staticListItems('learn/knowledge-base#2');
const gettingStartedCats = gettingStartedCatItems.map((item) => ({
  slug: item.fieldData.slug as string,
  name: (item.fieldData.name as string) ?? '',
  iconUrl: categoryIcon(item),
  count: (item.fieldData['number-of-questions'] as string) ?? '',
}));

const featuredQuestionItems = await staticListItems('learn/knowledge-base#3');
const featuredQuestions = featuredQuestionItems.map((item) => ({
  slug: item.fieldData.slug as string,
  title: (item.fieldData.name as string) ?? '',
  iconUrl: articleIcon(item),
}));
