---
// The partners detail template, nativised (REBUILD-PLAN.md Phase 4 step 3, shape
// 923a59d8 -- see GenericDetailPage.astro's doc comment). DetailPage/
// render-detail.mjs and the partners shell+bindings stay in the tree -- other
// collections still use that path -- but /partners/<slug> no longer does.
import { getPaths } from '../../lib/content';
import GenericDetailPage from '../../components/detail-shared/GenericDetailPage.astro';

export const getStaticPaths = () => getPaths('partners');
const { item } = Astro.props;
---
<GenericDetailPage collection="partners" wfPageId="674713bef8d85630ffcf63dd" slug={item.fieldData.slug as string} />
