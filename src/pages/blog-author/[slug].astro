---
// The blog-author detail template, nativised (REBUILD-PLAN.md Phase 4, taxonomy shape
// 750a7bb4, 14 pages): real Astro markup fed by content collections, replacing the
// DetailPage.astro shell-splicing path for this one route. DetailPage/render-detail.mjs/
// this collection's shell+bindings stay in the tree -- other collections still use that
// path -- but /blog-author/<slug> no longer does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["blog-author"] already recorded (proven
// static across all 14 items, not per-item data), hardcoded here rather than parsed
// at build time since this route no longer reads that manifest for anything else.
// bodyAttrs is empty for this collection. Unlike blog-category, this collection's
// shell carries NO banner-wrap block before the nav (confirmed byte-diffing the two
// shells) -- omitted here, not an oversight.
//
// Shared with blog-category (see src/lib/blog-taxonomy-detail.ts for why): the
// post-list and "explore more topics" blocks. blog-author never self-highlights any
// tag (its post list's category pills reference blog-category, never blog-author, so
// they can never match this page's own path) -- currentCategorySlug is left undefined.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/render-detail.mjs';
import { getTaxonomyPosts, getTaxonomyTopics, headDescription, headImage } from '../../lib/blog-taxonomy-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import BlogAuthorHero from '../../components/blog-author/BlogAuthorHero.astro';
import TaxonomyPostList from '../../components/blog-taxonomy/TaxonomyPostList.astro';
import TaxonomyTopics from '../../components/blog-taxonomy/TaxonomyTopics.astro';

export const getStaticPaths = () => getPaths('blog-author');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/blog-author/${slug}`;

const [posts, topics] = await Promise.all([
  getTaxonomyPosts('blog-author', slug),
  getTaxonomyTopics('blog-author', slug),
]);

const title = resolveHeadTitle('blog-author', item) ?? '| The Radix Blog | Radix DLT';
const description = headDescription(item);
const image = headImage(item);
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive.
const headTail = readFileSync('src/components/detail-shared/detail-head.html', 'utf8');
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d94c" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title={title}
      description={description}
      ogTitle={title}
      ogDescription={description}
      ogImage={image}
      twitterTitle={title}
      twitterDescription={description}
      twitterImage={image}
      ogType
      twitterCard
      canonical={`https://www.radixdlt.com${currentPath}`}
      tail={headTail}
    />
  </head>
  <body>
    <SiteNav variant="blog" currentPath={currentPath} />
    <div class="search-mobile">
      <div class="container">
        <form action="/search" class="c-search w-form">
          <input class="search-input w-input" maxlength="256" name="query" placeholder="Search the blog…" type="search" id="search" required />
          <input type="submit" class="t_button is-search w-button" value="Search" />
        </form>
      </div>
    </div>
    <BlogAuthorHero item={item} />
    <TaxonomyPostList posts={posts} />
    <TaxonomyTopics
      topics={topics}
      discoverNodeId="w-node-f088afb5-96ef-704c-faa7-a5f5a2c92d1a-8a57d94c"
      videoId="f088afb5-96ef-704c-faa7-a5f5a2c92d21-video"
    />
    <SiteFooter variant="main" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
