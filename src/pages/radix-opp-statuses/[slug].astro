---
// The radix-opp-statuses detail template, nativised (REBUILD-PLAN.md Phase 4): real
// Astro markup fed by content collections, replacing the DetailPage.astro
// shell-splicing path for this one route. DetailPage/render-detail.mjs/this
// collection's shell+bindings stay in the tree -- other collections still use that
// path -- but /radix-opp-statuses/<slug> no longer does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["radix-opp-statuses"] already recorded
// (proven static across all 36 items, not per-item data), hardcoded here rather than
// parsed at build time since this route no longer reads that manifest for anything
// else. bodyAttrs is empty for this collection (no attributes on <body>).
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/render-detail.mjs';
import { fmtDate, richText, getServices } from '../../lib/radix-opp-statuses-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import RadixOppStatusSection from '../../components/radix-opp-statuses/RadixOppStatusSection.astro';

export const getStaticPaths = () => getPaths('radix-opp-statuses');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/radix-opp-statuses/${slug}`;

const services = await getServices(item);

const title = resolveHeadTitle('radix-opp-statuses', item) ?? '| Radix DLT | Services Status';
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive. The head tail is genuinely shared across
// collections (byte-identical apart from the canonical URL -- see
// src/components/detail-shared/GenericDetailPage.astro's own note on this), so it's
// read from that shared asset rather than duplicated per collection.
const headTail = readFileSync('src/components/detail-shared/detail-head.html', 'utf8');
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="69eb0cc49d33f411d5e04328" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head><SiteHead title={title} canonical={`https://www.radixdlt.com${currentPath}`} tail={headTail} /></head>
  <body>
    <SiteNav variant="status" currentPath={currentPath} />
    <RadixOppStatusSection
      title={item.fieldData.name as string}
      services={services}
      dateReportedText={fmtDate(item.fieldData['date-reported'])}
      lastUpdateText={fmtDate(item.fieldData['last-update'])}
      status={item.fieldData.status as string}
      contentHtml={richText(item)}
    />
    <SiteFooter variant="status" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
