---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lifted verbatim from
// src/shells/blog/body.{0,0.post,1,2,3,4,5,6,7,8}.html -- the main blog listing, a
// standalone page shape not shared with any other route.
//
// Eight CMS lists, item SELECTION read from src/bindings/_lists.json (Finsweet's
// actual render, not reproducible from CMS data); field VALUES resolved live
// through src/lib/blog-detail.ts, the same helpers src/pages/all-recent-posts.astro
// and the nativised blog detail template already use:
//   - list.0 ("blog#0", 4 items) -- the featured-post carousel at the top.
//   - list.1 ("blog#1", 12 items) -- the "All recent posts" tab. Each card has its
//     OWN nested category-pill w-dyn-list, IDENTICAL in shape to
//     all-recent-posts.astro's own post grid. FIXES the task's flagged defect
//     (18 pages short of live's inline style="" count, this page included): the
//     pill's `style="color:...;background-color:..."` comes from
//     src/lib/blog-detail.ts's tagStyle(), the same fix already applied on
//     all-recent-posts.astro. None of these 12 posts has zero categories
//     (verified against reference/webflow/items/blog.json), so the nested list's
//     w-dyn-empty branch is unreachable here and not fabricated -- the raw shell
//     itself (list.1.html) never captured that branch either.
//   - list.2 ("blog#2", 12 items, "Scrypto & Developers" tab) -- same template as
//     list.1 but WITHOUT the category-pill nest, and its <p class="blog-desc">
//     bound to the post's OWN `seo-meta-description` field (verified against
//     reference/live/blog.html: 11 of these 12 posts have no
//     seo-meta-description and render `<p class="blog-desc w-dyn-bind-empty">`;
//     the twelfth, "250m-xrd-10m-to-power-the-next-web3-breakthrough...", has one
//     and live renders it filled, byte-for-byte). This is the SAME field
//     TaxonomyPostList.astro already binds for this exact reason (NOT `excerpt`,
//     which is a different field bound to the HEAD meta description instead).
//   - list.3/4/5 ("blog#3/4/5", 12 items each, "Product & Roadmap" /
//     "Crypto & DeFi" / "Radix Labs" tabs) -- same template as list.2 but with NO
//     slot at all for blog-desc in src/bindings/_lists.json (unlike list.2); none
//     of these 36 posts has a seo-meta-description value either, so a bound-but-
//     empty render and a genuinely-unbound render are byte-identical and
//     indistinguishable from data alone. Trusting the verified _lists.json
//     derivation (rather than guessing a binding it did not find) per the task's
//     "do not guess CMS field names" rule: left as the shell's own literal
//     `<p class="blog-desc w-dyn-bind-empty"></p>` placeholder, unbound.
//   - list.6 ("blog#6", 11 items, "blog-category" collection) -- the "Explore more
//     topics" plain-text tag links, identical in shape to
//     all-recent-posts.astro's own.
//   - list.7 ("blog#7", 6 items) -- a small secondary post slider. Each item's
//     "tag-link-holder" contains a STATIC (not per-item-bound) Finsweet
//     `w-embed w-script` block that AJAX-loads `/blog/ .coll-list-nest`
//     client-side -- reproduced verbatim per item, matching the shell exactly (it
//     is not a CMS-bound field).
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace
// run that contained a newline in the original shell has been collapsed to a
// single literal space -- both per REBUILD-PLAN.md section 11.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { staticListItems } from '../lib/static-lists';
import { getCategories, tagStyle, dynClass, fmtDate, heroImage } from '../lib/blog-detail';

const currentPath = '/blog';
const headTail = readFileSync('src/components/blog-index/blog-index-head.html', 'utf8');

const postFields = (item: Awaited<ReturnType<typeof staticListItems>>[number]) => ({
  slug: item.fieldData.slug as string,
  title: (item.fieldData.name as string) ?? '',
  imageUrl: heroImage(item),
  dateText: fmtDate(item.fieldData.date),
});

const loadPosts = async (key: string) => {
  const items = await staticListItems(key);
  return items.map(postFields);
};

const loadPostsWithDesc = async (key: string) => {
  const items = await staticListItems(key);
  return items.map((item) => ({ ...postFields(item), desc: (item.fieldData['seo-meta-description'] as string) ?? '' }));
};

const featured = await loadPosts('blog#0');

const allPostsItems = await staticListItems('blog#1');
const allPosts = await Promise.all(allPostsItems.map(async (item) => ({
  slug: item.fieldData.slug as string,
  title: (item.fieldData.name as string) ?? '',
  imageUrl: heroImage(item),
  dateText: fmtDate(item.fieldData.date),
  categories: await getCategories(item),
})));

const scryptoPosts = await loadPostsWithDesc('blog#2');
const productPosts = await loadPosts('blog#3');
const cryptoPosts = await loadPosts('blog#4');
const labsPosts = await loadPosts('blog#5');

const categoryItems = await staticListItems('blog#6');
const categories = categoryItems.map((item) => ({
  slug: item.fieldData.slug as string,
  name: (item.fieldData.name as string) ?? '',
}));

const smallSlider = await loadPosts('blog#7');
