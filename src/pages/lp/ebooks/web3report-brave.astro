---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Body markup lives in
// ../../../components/lp-ebooks/Web3ReportBody.astro, shared verbatim with
// web3report.astro (see that file's header for what's templated and why).
// Single self-contained landing page: manifest.json's order is just [html], no
// SiteNav/SiteFooter -- confirmed from the shell, not assumed.
import { readFileSync } from 'node:fs';
import SiteHead from '../../../components/site/SiteHead.astro';
import Web3ReportBody from '../../../components/lp-ebooks/Web3ReportBody.astro';

const headTail = readFileSync('src/components/lp-ebooks/web3report-head.html', 'utf8');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57da36" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="eBook Landing Brave"
      ogTitle="eBook Landing Brave"
      twitterTitle="eBook Landing Brave"
      canonical="https://www.radixdlt.com/lp/ebooks/web3report-brave"
      tail={headTail}
    />
  </head>
  <body class="c-landing">
    <Web3ReportBody pageIdSuffix="8a57da36" formId="X3aacX" />
  </body>
</html>
