---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Shares its body with the other two lp/brave/*
// pages via ../../../components/lp-brave/BraveLandingBody.astro (the "lp/brave x3"
// family) -- see that file's header for what's templated and why. Head tail shared
// too (../../../components/lp-brave/brave-head.html, byte-identical across all
// three apart from the canonical link, which SiteHead substitutes via its
// __CANON__ placeholder).
import { readFileSync } from 'node:fs';
import SiteHead from '../../../components/site/SiteHead.astro';
import BraveLandingBody from '../../../components/lp-brave/BraveLandingBody.astro';

const currentPath = '/lp/brave/discover-report';
const headTail = readFileSync('src/components/lp-brave/brave-head.html', 'utf8');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d96b" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Discover-ebook"
      description="Web 3 Fintech is inevitable. The only question: how will it be powered? Radix is the only Layer-1 protocol intentionally designed to meet the needs of billions of users and trillions worth of assets."
