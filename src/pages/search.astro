---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing.
//
// This route's own search RESULTS are not a Webflow CMS list at all -- Webflow's
// hosted site search doesn't survive the subscription, so Pagefind replaces it via
// public/js/site-search.js (see src/lib/page-extras.mjs, reproduced below as a plain
// <script> since WebflowPage.astro's bodyExtras() mechanism goes away with it). The
// ONE actual w-dyn-list on this page (list.0.html) is the "Explore more topics" tag
// list -- the same blog-category list src/components/blog/BlogTags.astro already
// renders for the blog detail template, same shape and same collection. Item
// SELECTION comes from src/bindings/_lists.json's "search#0" entry (11 items) per
// REBUILD-PLAN.md section 11.
//
// The "No relevant posts match your search" block (div.c-section.is-blog-cat) is
// NOT in src/shells/search/body.0.post.html -- that shell has only an empty
// <div class="container"></div> there, verified as a pre-existing export gap (the
// same emptiness is already present in the CURRENT WebflowPage.astro-rendered dist/
// output, confirmed by diffing a throwaway build against this file's unmodified
// version before this change). It carries no w-dyn-* class at all (not a CMS list,
// static literal text), and reference/live/search.html shows it in full, so it's
// reproduced verbatim here to close that gap rather than propagate it.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import LongformRuntime from '../components/longform/LongformRuntime.astro';
import { staticListItems } from '../lib/static-lists';

const currentPath = '/search';
const headTail = readFileSync('src/components/search-page/search-head.html', 'utf8');

const topics = await staticListItems('search#0');
---
<!doctype html>
<html data-wf-page="649aa8a9681ec6168a57d9fb" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Blog Search Results | Radix DLT - Decentralized Ledger Technology"
      ogTitle="Blog Search Results | Radix DLT - Decentralized Ledger Technology"
      twitterTitle="Blog Search Results | Radix DLT - Decentralized Ledger Technology"
      tail={headTail}
    />
  </head>
  <body>

  <div class="banner-wrap">
    <div data-w-id="421cf4db-2453-441c-6135-5b6acee23bfc" class="x-holder x2"><img src="/images/close-1.svg" loading="lazy" alt="" class="imgclose"></div>
  </div>
  <SiteNav variant="blog" currentPath={currentPath} />
  <div class="search-mobile">
    <div class="container">
      <form action="/search" class="c-search w-form"><input class="search-input w-input" maxlength="256" name="query" placeholder="Search the blog…" type="search" id="search" required><input type="submit" class="t_button is-search w-button" value="Search"></form>
    </div>
  </div>
  <div class="c-section is-blog">
    <div class="main-content">
      <div class="container is-small">
        <div class="bm-20">
          <a href="/blog" class="blog-link">Blog home</a>
        </div>
        <div class="bm-20">
          <h1 id="search-term">...</h1>
        </div>
        <h4>Your results</h4>
      </div>
    </div>
    <div class="main-blog-bg">
      <div class="bottom-triangle"><img src="/images/traingle-hero-white.webp" loading="lazy" sizes="100vw" srcset="/images/traingle-hero-white-p-500.png 500w, /images/traingle-hero-white-p-800.png 800w, /images/traingle-hero-white-p-1080.png 1080w, /images/traingle-hero-white-p-2600.png 2600w, /images/traingle-hero-white-p-3200.png 3200w, /images/traingle-hero-white.webp 4096w" alt="" class="blog-triangle"></div>
    </div>
  </div>
  <div class="c-section is-blog-cat">
    <div class="container">
      <div>
        <div class="empty-state-2">
          <div><strong>No relevant posts match your search</strong></div>
        </div>
      </div>
    </div>
  </div>
  <div class="c-section is-tags">
    <div class="container z-index-20">
      <div class="div-block-130">
        <div id="w-node-_8699529b-d7b9-aed8-3d07-8036eb986347-8a57d9fb">
          <div>Discover</div>
          <h2>Explore more topics</h2>
        </div>
        <div id="w-node-_80aa40a1-f822-b623-25ed-3d3823cd4943-23cd4943" class="w-dyn-list">
          {topics.length > 0 ? (
            <div role="list" class="w-dyn-items">
              {topics.map((t) => {
                const slug = t.fieldData.slug as string;
                const name = (t.fieldData.name as string) ?? '';
                return (
                  <div role="listitem" class="collection-item w-dyn-item">
                    <a href={`/blog-category/${slug}`} class="tag-link">{name}</a>
                  </div>
                );
              })}
            </div>
          ) : (
            <div class="w-dyn-empty">
              <div>No items found.</div>
            </div>
          )}
        </div>
      </div>
    </div>
    <div class="mesh-holder">
      <div data-poster-url="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-poster-00001.jpg" data-video-urls="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.mp4,/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" data-beta-bgvideo-upgrade="false" class="mesh-vid-2 z5 w-background-video w-background-video-atom">
        <video id="8699529b-d7b9-aed8-3d07-8036eb98634e-video" autoplay loop style="background-image:url(&quot;/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-poster-00001.jpg&quot;)" muted playsinline data-wf-ignore="true" data-object-fit="cover">
          <source src="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.mp4" data-wf-ignore="true" />
          <source src="/assets/60ba5985f394bf1012c0c83a_Comp-1-v2-transcode.webm" data-wf-ignore="true" />
        </video>
      </div>
      <div class="bottom-triangle"><img src="/images/traingle-hero-white.webp" loading="lazy" sizes="100vw" srcset="/images/traingle-hero-white-p-500.png 500w, /images/traingle-hero-white-p-800.png 800w, /images/traingle-hero-white-p-1080.png 1080w, /images/traingle-hero-white-p-2600.png 2600w, /images/traingle-hero-white-p-3200.png 3200w, /images/traingle-hero-white.webp 4096w" alt="" class="blog-triangle"></div>
    </div>
  </div>
  <SiteFooter variant="main" currentPath={currentPath} />
  <LongformRuntime />
  <script is:inline>
function qs(key) {
    key = key.replace(/[*+?^$.\[\]{}()|\\\/]/g, "\\$&"); // escape RegEx control chars
    var match = location.search.match(new RegExp("[?&]" + key + "=([^&]+)(&|$)"));
    return match && decodeURIComponent(match[1].replace(/\+/g, " "));
}
$("#search-term").text('"' + qs('query') + '"');
</script>
  <script type="module" is:inline src="/js/site-search.js"></script>
  </body>
</html>
