---
// Nativised static page (REBUILD-PLAN.md section 11). Real Astro markup, no
// WebflowPage.astro shell splicing. Shares its body with notices/updates.astro via
// src/components/notices/NoticesBody.astro (the "notices x2" family) -- the two
// pages are byte-identical apart from which tab carries the current-page highlight.
import { readFileSync } from 'node:fs';
import SiteHead from '../components/site/SiteHead.astro';
import NoticesBody from '../components/notices/NoticesBody.astro';

const currentPath = '/notices';
const headTail = readFileSync('src/components/notices/notices-head.html', 'utf8');
---
<!doctype html>
<html data-wf-page="65006f1c9db2c329b4ec94e8" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head>
    <SiteHead
      title="Notices - Known Issues | Radix DLT - Decentralized Ledger Technology"
      ogTitle="Notices - Known Issues | Radix DLT - Decentralized Ledger Technology"
      twitterTitle="Notices - Known Issues | Radix DLT - Decentralized Ledger Technology"
      tail={headTail}
    />
  </head>
  <body>
  <NoticesBody current="known-issues" currentPath={currentPath} />
  </body>
</html>
