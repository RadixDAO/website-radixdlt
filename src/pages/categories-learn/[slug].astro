---
// The categories-learn detail template, nativised (REBUILD-PLAN.md Phase 4, taxonomy
// shape 7fdbbe65, 5 pages): real Astro markup fed by content collections, replacing
// the DetailPage.astro shell-splicing path for this one route. DetailPage/
// render-detail.mjs/this collection's shell+bindings stay in the tree -- other
// collections still use that path -- but /categories-learn/<slug> no longer does.
//
// htmlAttrs/bodyAttrs/nav variant/footer variant below are the same per-collection
// constants src/shells/_detail/manifest.json["categories-learn"] already recorded
// (proven static across all 5 items, not per-item data), hardcoded here rather than
// parsed at build time since this route no longer reads that manifest for anything
// else. bodyAttrs is empty; this collection's shell carries no banner-wrap or
// search-mobile block (unlike the blog-family templates).
//
// Shared with sub-categories-learn (see src/lib/categories-learn-detail.ts for why):
// the hero and question-list blocks. This is the collection with BOTH question-list
// sections ("Featured Questions" and "All questions"); sub-categories-learn has only
// the first.
import { readFileSync } from 'node:fs';
import { getPaths } from '../../lib/content';
import { resolveHeadTitle } from '../../lib/render-detail.mjs';
import { categoryIcon, getQuestions } from '../../lib/categories-learn-detail';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import CategoryHero from '../../components/learn-taxonomy/CategoryHero.astro';
import QuestionList from '../../components/learn-taxonomy/QuestionList.astro';

export const getStaticPaths = () => getPaths('categories-learn');
const { item } = Astro.props;

const slug = item.fieldData.slug as string;
const currentPath = `/categories-learn/${slug}`;

const [featured, all] = await Promise.all([
  getQuestions('categories-learn', slug, '0'),
  getQuestions('categories-learn', slug, '1'),
]);

const title = resolveHeadTitle('categories-learn', item) ?? '| The Radix Knowledge Base';
// Read from src/components/, NOT src/shells/. src/shells is scaffolding scheduled for
// deletion (REBUILD-PLAN.md 10.5); reading it at build time would block that deletion
// and quietly keep the shell pipeline alive.
const headTail = readFileSync('src/components/detail-shared/detail-head.html', 'utf8')
  .replace('__CANON__', 'https://www.radixdlt.com/detail_categories-learn');
const scriptsTail = readFileSync('src/components/detail-shared/scripts-tail.html', 'utf8');
---
<!doctype html>
<html data-wf-page="69eb1e92745be047bb44b53b" data-wf-site="6053f7fca5bf627283b582c2" lang="en">
  <head><SiteHead title={title} tail={headTail} /></head>
  <body>
    <SiteNav variant="learn" currentPath={currentPath} />
    <CategoryHero iconUrl={categoryIcon(item)} title={(item.fieldData.name as string) ?? ''} />
    <QuestionList title="Featured Questions" items={featured} emptyStateClass="empty-state-8 w-dyn-empty" />
    <QuestionList title="All questions" items={all} itemWrapperClass="question-wrapper" emptyStateClass="w-dyn-empty" />
    <SiteFooter variant="learn" currentPath={currentPath} />
    <Fragment set:html={scriptsTail} />
  </body>
</html>
