  <script is:inline>
$(document).ready(function() {
    // Global variables
    let $mainCarousel = $('.carousel-main');
    let $navCarousel = $('.carousel-nav');
    let interval;
    // Initialize carousels
    let flktyMain = new Flickity($mainCarousel[0], {
        pageDots: false,
        wrapAround: true,
        autoPlay: 10000,
        pauseAutoPlayOnHover: false,
        prevNextButtons: false, // Remove arrows
        draggable: false, // Disable dragging
        selectedAttraction: 1,
    		friction: 1
    });
    let flktyNav = new Flickity($navCarousel[0], {
        asNavFor: '.carousel-main',
        contain: true,
        pageDots: false,
        draggable: true,
        cellAlign: 'left', 
        prevNextButtons: false // Remove arrows
    });
    $(window).on('load', function() {
      flktyMain.resize();
      flktyNav.resize();
    });
    $(window).on('resize', function() {
        flktyMain.resize();
        flktyNav.resize();
    });
    // Helper functions
    function updateProgressBar(index) {
        let $progressElement = $($navCarousel.find('.carousel-cell')[index]).find('.progress');
        let progressWidth = parseInt($progressElement.css('width'), 10);
        interval = setInterval(function() {
            progressWidth += 1;
            $progressElement.css('width', progressWidth + "%");
            if (progressWidth >= 100) {
                clearInterval(interval);
            }
        }, 99);
    }
    function resetProgressBars() {
        $navCarousel.find('.progress').css('width', '0%');
    }
    // Event listeners
    // Slide change detection
    flktyMain.on('change', function(index) {
        clearInterval(interval);
        resetProgressBars();
        updateProgressBar(index);
        flktyMain.resize();
        flktyNav.resize();
        // Manually fade in the selected slide
        let $selectedSlide = $($mainCarousel.find('.carousel-cell')[index]);
        $selectedSlide.css('opacity', 0).delay(100).animate({ opacity: 1 }, 200);
    });
    // User interaction with the AsNavFor carousel
    $navCarousel.on('click', '.carousel-cell', function() {
        let clickedIndex = $(this).index();
        if (flktyMain.selectedIndex === clickedIndex) {
            // If user clicked on the currently active slide
            clearInterval(interval);
            resetProgressBars();
            updateProgressBar(clickedIndex);
            flktyMain.stopPlayer();
            flktyMain.playPlayer();
        } else {
            flktyMain.stopPlayer();
            setTimeout(() => {
                flktyMain.playPlayer();
            }, 100);
        }
    });
    // Pause and resume on hover
    /*$mainCarousel.on('mouseover', function() {
        clearInterval(interval);
        flktyMain.pausePlayer();
    });
    $mainCarousel.on('mouseout', function() {
        let $progressElement = $($navCarousel.find('.carousel-cell')[flktyMain.selectedIndex]).find('.progress');
        let progressWidth = parseInt($progressElement.css('width'), 10);
        if (progressWidth >= 100) {
            flktyMain.next();
        } else {
            flktyMain.playPlayer();
            updateProgressBar(flktyMain.selectedIndex);
        }
    });*/
    // Initialize the progress bar for the first slide
    updateProgressBar(0);
});
</script>
