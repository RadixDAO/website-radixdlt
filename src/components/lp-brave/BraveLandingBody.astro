---
// Shared body for the lp/brave/* family (REBUILD-PLAN.md section 11): discover,
// brave-landing and discover-report share this page shape byte-for-byte apart from
// a handful of spots -- verified via pairwise diff of
// src/shells/lp/brave/{discover,brave-landing,discover-report}/body.{0,1}.html:
//   - the top/bottom MailerLite embedded-form ids (topFormId/bottomFormId)
//   - the top hero headline (typed.js span on discover/brave-landing, plain report
//     copy on discover-report) and the bottom signup headline (same split) -- passed
//     as raw HTML strings since the only per-page difference is the copy, not the
//     wrapping <h4>
//   - the three social-follower counts in the "c-flex-inline brave" strip
//   - the w-node id suffix (the last 8 hex chars of each page's own data-wf-page,
//     appearing 9 times in body.1) used purely for Webflow's IX2 targeting
//
// The one CMS list (list.0.html, the "tweets" carousel) is shared verbatim too --
// src/bindings/_lists.json's lp/brave/discover#0, lp/brave/brave-landing#0 and
// lp/brave/discover-report#0 entries all resolve to the identical 24-slug
// selection -- fetched per page via its own key (staticListItems), field VALUES
// resolved live through src/lib/tweets-list.ts.
//
// Every <script>/<style> below carries is:inline, and every inter-tag whitespace
// run that contained a newline in the original shell has been collapsed to a
// single literal space -- both per REBUILD-PLAN.md section 11 (Astro round-trips
// Webflow markup byte-identically only under those two conditions; otherwise it
// stamps data-astro-cid, bundles the CDN scripts, and silently deletes newline-
// containing whitespace text nodes that used to render as a gap).
import SiteFooter from '../site/SiteFooter.astro';
import { staticListItems } from '../../lib/static-lists';
import { dynClass, tweetContent, tweetName, tweetUrl, avatarStyle } from '../../lib/tweets-list';

interface Props {
  currentPath: string;
  pageIdSuffix: string;
  listKey: string;
  topHeadlineHtml: string;
  topFormId: string;
  bottomHeadlineHtml: string;
  bottomFormId: string;
  twitterFollowers: string;
  discordFollowers: string;
  telegramFollowers: string;
}
const {
  currentPath, pageIdSuffix, listKey, topHeadlineHtml, topFormId,
  bottomHeadlineHtml, bottomFormId, twitterFollowers, discordFollowers, telegramFollowers,
} = Astro.props;

const tweets = await staticListItems(listKey);
