---
// The site nav shared by every nav-bearing page (see REBUILD-PLAN.md Task 2.2).
//
// `variant` selects one of the canonical blocks derived by
// tools/derive-nav-variants.mjs into src/chrome/nav.<variant>.html (verbatim
// substrings of the built site -- see that script's header for how the ten variants
// were measured and named). `currentPath` is spliced in via src/lib/mark-current.mjs,
// which reproduces Webflow's own current-page marking exactly -- proven against every
// one of the 962 nav-bearing pages (verified during the Webflow migration).
//
// Built as a plain string and rendered through ONE <Fragment set:html>, same as
// SiteHead.astro -- Astro must never parse Webflow markup (attribute order, inline
// <script> bodies and IX2 `data-w-id` hooks all survive a byte splice and none of
// them survive a parser round-trip).
//
// A page with no nav (240 of them -- e.g. 401, the /lp/* landing pages) simply omits
// the `variant` prop and renders nothing.
import { markCurrent } from '../../lib/mark-current.mjs';

interface Props {
  variant?: string;
  currentPath: string;
}

const { variant, currentPath } = Astro.props;

// Eager ?raw import (same pattern as WebflowPage.astro's shells glob) rather than a
// runtime readFileSync: at build time the component's own compiled location moves,
// so a path resolved relative to import.meta.url no longer points at the source tree.
const blocks = import.meta.glob<string>('../../chrome/*.html', {
  query: '?raw', import: 'default', eager: true,
});
function canonicalBlock(name: string): string {
  const key = `../../chrome/nav.${name}.html`;
  const v = blocks[key];
  if (v === undefined) throw new Error(`Missing canonical nav block ${key}`);
  return v;
}

const html = variant ? markCurrent(canonicalBlock(variant), currentPath) : '';
---
{html && (
  <div class="dao-vote-strip">
    <div class="dao-vote-inner">
      <span class="dao-vote-tag">Vote open</span>
      <p>The Radix DAO formation vote is live. Have your say on forming the DAO.</p>
      <a href="https://vote.radixdao.org/proposal/0">Cast your vote <span aria-hidden="true">&rsaquo;</span></a>
    </div>
  </div>
)}
{html && <Fragment set:html={html} />}

<style>
  /* Mirrors the status strip on radixdao.org (accent + accent-soft there). */
  .dao-vote-strip { background: #fbeaf4; border-bottom: 1px solid #f0d3e4; color: #0a1226; }
  .dao-vote-inner {
    max-width: 1200px; margin: 0 auto; padding: 10px 24px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px;
    font-size: 13.5px; line-height: 1.4;
  }
  .dao-vote-inner p { margin: 0; }
  .dao-vote-tag {
    background: #a80c7c; color: #fff; border-radius: 3px; padding: 3px 8px;
    font-size: 11px; font-weight: 500; letter-spacing: 0.09em; text-transform: uppercase;
  }
  .dao-vote-inner a { margin-left: auto; color: #a80c7c; font-weight: 500; white-space: nowrap; }
</style>
