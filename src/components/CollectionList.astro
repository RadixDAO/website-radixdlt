---
// A Webflow `w-dyn-list` slot.
//
// The shell contains exactly one placeholder `w-dyn-item`. renderList clones it per
// CMS item and fills the slots derived in src/bindings/_lists.json, leaving every
// surrounding byte untouched -- which is what keeps Finsweet's fs-cmsfilter /
// fs-cmsnest / fs-cmsload attributes working, since they key off Webflow's list DOM.
//
// A list with no binding returns the shell verbatim. Half-filling is never correct.
import { renderList } from '../lib/render-list.mjs';

interface Props { route: string; index: number; shell: string }
const { route, index, shell } = Astro.props;

const html = renderList(route, index, shell);
---
<Fragment set:html={html} />
