---
// One item of developers/ecosystem's "blueprints-developers" CMS lists (REBUILD-PLAN.md
// section 11) -- shared across all 10 non-empty per-category tabs (list.0 through
// list.10, minus the confirmed-empty list.7 "Gaming"). Markup from
// src/shells/developers/ecosystem/list.0.html's placeholder w-dyn-item, identical byte-
// for-byte across all 11 list shells.
//
// `showIcon` reproduces a genuine PER-LIST Webflow binding difference, not a per-item
// one: verified against reference/live/developers/ecosystem.html that the Stablecoins,
// Lending and Insurance tabs never render the icon's background-image style even for
// items (DegenFi, DeMIFI) whose `icon` field is set to the exact same shared asset that
// DOES render in every other tab -- so those three Collection List instances simply
// never had the Icon field bound in Webflow's designer, independent of item content.
//
// The CTA button (c-b-link-holder) is not in src/bindings/_lists.json at all -- the
// slot deriver only handles text/attr:style binds, not a Link field's two-variant
// conditional markup. Resolved here instead; see src/lib/developers-ecosystem.ts.
import type { CmsItem } from '../../lib/content';
import { assetPath } from '../../lib/content';
import { dynClass } from '../../lib/full-stack-social';
import { blueprintLink } from '../../lib/developers-ecosystem';

interface Props {
  item: CmsItem;
  showIcon: boolean;
}
const { item, showIcon } = Astro.props;
const name = (item.fieldData.name as string) ?? '';
const username = (item.fieldData.username as string) ?? '';
const description = (item.fieldData.description as string) ?? '';
const iconUrl = (item.fieldData.icon as { url?: string } | undefined)?.url;
const iconStyle = showIcon
  ? (iconUrl ? `background-image:url("${assetPath(iconUrl)}")` : 'background-image:none')
  : undefined;
const link = blueprintLink(item);
---
<div role="listitem" class="c-blueprint w-dyn-item">
  <div class="icon-holder">
    <div class="c-icon-cms" style={iconStyle}></div>
  </div>
  <div class="c-b-holder">
    <div class="c-b-top">
      <div class={dynClass('c-name', !!name)}>{name}</div>
      <div class={dynClass('c-username', !!username)}>{username}</div>
    </div>
    <div class="c-b-bottom">
      <div class={dynClass('', !!description)}>{description}</div>
    </div>
  </div>
  <div class="c-b-link-holder">
    {link && (
      <a href={link.href} target="_blank" class={link.isWeb ? 't_button-18 is_alt_btn-dark is-web w-inline-block' : 't_button-18 is_alt_btn-dark w-inline-block'}>
        <div class="icon-chat-2 w-embed">
          {link.isWeb ? (
            <svg width="24px" height="24px" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
          ) : (
            <svg width="24px" height="24px" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" x2="21" y1="14" y2="3"></line></svg>
          )}
        </div>
        <div>{link.isWeb ? 'Github' : 'Website'}</div>
      </a>
    )}
  </div>
</div>
