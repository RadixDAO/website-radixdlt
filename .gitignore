webflow.json

# ---------------------------------------------------------------------------
# What is NOT ignored, and why
# ---------------------------------------------------------------------------
# source/webflow-export/  the Webflow static export, committed in full (241 MB).
#                         It dies with the Webflow subscription and is the input to
#                         every converter. Nothing here is regenerable.
# reference/live/         1,209-page snapshot of the live site: the verification
#                         oracle. Cannot be recaptured once Webflow stops serving.
# reference/webflow/      CMS pull: 29 collections, 1,590 items, field schemas.
# src/shells/             generated markup, but committed -- a fresh clone must build
#                         without re-running the converter. `pnpm convert` regenerates.

# Derived copies of committed source. `node tools/copy-static-assets.mjs` recreates
# these from source/webflow-export/.
public/css/
public/js/
public/fonts/
public/images/
public/videos/
public/documents/

# The 913 MB Webflow CDN mirror. Reproducible from reference/asset-map.json only while
# the Webflow CDN is alive -- see REBUILD-PLAN.md 0.2 for the R2 + checksum plan.
public/assets/

reference/mirror-live.log
reference/live-failures.txt
